                        <tr><td class="m-cell">2.2</td><td class="m-cell">Grundparametrierung der Messgeräte erfolgt.</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">2.3</td><td class="m-cell">Anlage geprüft (siehe Prüfprotokoll)</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><th class="m-cell">3.)</th><th class="m-cell" style="text-align:left;">Sichtkontrolle</th><th class="m-cell" style="text-align:left;">Prüfer<br/>(Kürzel)</th><th class="m-cell" style="text-align:left;">Bemerkung<br/><span style="font-weight:400; font-size:6.7pt;">Nur bei Abweichung/Einschränkung ausfüllen</span></th></tr>
                        <tr><td class="m-cell">3.0</td><td class="m-cell">Schrankbeschriftung (Typenschild, Infoschild und Warnschilder)</td><td class="m-cell"></td><td class="m-cell"></td></tr>
