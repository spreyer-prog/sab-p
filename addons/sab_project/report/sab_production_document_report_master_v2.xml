<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sab_production_document_master_v2" inherit_id="sab_project.report_sab_production_document" priority="990">
        <xpath expr="//style" position="inside">
            .sab-master-page { width:190mm; min-height:277mm; margin:0 auto; font-family:Arial, Helvetica, sans-serif; color:#000; box-sizing:border-box; }
            .sab-master-page table { border-collapse:collapse; table-layout:fixed; width:100%; }
            .sab-master-page td, .sab-master-page th { box-sizing:border-box; }
            .sab-master-page .m-border { border:0.35mm solid #000; }
            .sab-master-page .m-cell { border:0.35mm solid #000; padding:0.7mm 1.2mm; }
            .sab-master-page .m-bold { font-weight:700; }
            .sab-master-page .m-yellow { background:#fffda0; }
            .sab-master-page .m-orange { background:#f6bd87; }
            .sab-master-page .m-center { text-align:center; }
            .sab-master-page .m-right { text-align:right; }
            .sab-master-page .m-vtext { writing-mode:vertical-rl; transform:rotate(180deg); text-align:center; vertical-align:middle; }
            .sab-master-page .m-logo { max-width:51mm; max-height:21mm; object-fit:contain; }
            .sab-master-page .m-footer { position:relative; margin-top:4mm; font-size:7pt; }
        </xpath>

        <!-- Laufkarte 1:1-Master auf Basis Laufkarte.pdf -->
        <xpath expr="//t[@t-if=&quot;doc.document_type == 'run_card'&quot;]" position="replace">
            <t t-if="doc.document_type == 'run_card'">
                <div class="sab-master-page" style="font-size:10.5pt; line-height:1.0;">
                    <table style="border:0.55mm solid #000;">
                        <colgroup>
                            <col style="width:55mm;"/><col style="width:49mm;"/><col style="width:42mm;"/><col style="width:44mm;"/>
                        </colgroup>
                        <tr style="height:7.2mm;" class="m-yellow">
                            <td class="m-cell m-bold" style="font-size:12.5pt;">Laufkarte</td>
                            <td class="m-cell m-bold m-center" style="font-size:12.5pt;"><span t-out="doc.project_reference or ''"/></td>
                            <td class="m-cell m-bold" style="font-size:12.5pt;">Liefertermin:</td>
                            <td class="m-cell m-bold m-center" style="font-size:12.5pt;"><span t-field="doc.delivery_date"/></td>
                        </tr>
                        <tr style="height:7.1mm;"><td class="m-cell m-bold">Projekt:</td><td class="m-cell m-bold" colspan="3"><span t-out="doc.project_name or ''"/></td></tr>
                        <tr style="height:7.1mm;"><td class="m-cell m-bold">Kunde:</td><td class="m-cell m-bold" colspan="3"><span t-out="doc.customer_name or ''"/></td></tr>
                        <tr style="height:7.1mm;" class="m-yellow"><td class="m-cell m-bold">Bauteil:</td><td class="m-cell m-bold" colspan="3"><span t-out="doc.cabinet_instance_label or doc.cabinet_name or ''"/></td></tr>
                        <tr style="height:10.2mm;"><td class="m-cell" colspan="4" style="font-size:8.5pt; line-height:1.15;">Diese Laufkarte ist vollständig und wahrheitsgemäß auszufüllen!<br/>Unvollständig ausgefüllte Karten werden nicht angenommen und als nicht abgearbeitet gewertet.</td></tr>
                    </table>
                    <table style="border-left:0.55mm solid #000; border-right:0.55mm solid #000; border-bottom:0.55mm solid #000; margin-top:-0.35mm;">
                        <colgroup>
                            <col style="width:55mm;"/><col style="width:49mm;"/><col style="width:6mm;"/><col style="width:6mm;"/><col style="width:74mm;"/>
                        </colgroup>
                        <tr style="height:18mm;"><th class="m-cell" style="text-align:left; vertical-align:middle;">Abteilung / Tätigkeit</th><th class="m-cell" style="text-align:left; vertical-align:middle;">Mitarbeiter</th><th class="m-cell m-vtext" style="font-size:7pt;">fertig</th><th class="m-cell m-vtext" style="font-size:7pt;">gepr.</th><th class="m-cell" style="text-align:left; vertical-align:middle;">Bemerkung</th></tr>
                        <tr style="height:5.4mm;" class="m-orange"><td class="m-cell m-bold" colspan="5">Mechanische Fertigung</td></tr>
                        <tr style="height:14.6mm;"><td class="m-cell">Mechanischer Aufbau</td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr style="height:15.0mm;"><td class="m-cell">Bestückung Geräte</td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr style="height:15.0mm;"><td class="m-cell">Bestückung Klemmen</td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr style="height:21.5mm;"><td class="m-cell">Endkontrolle</td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr style="height:5.4mm;" class="m-orange"><td class="m-cell m-bold" colspan="5">Elektrische Fertigung</td></tr>
                        <tr style="height:14.8mm;"><td class="m-cell">Vorbereitung Verdrahtung</td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr style="height:15.6mm;"><td class="m-cell">Verdrahtung</td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr style="height:21.7mm;"><td class="m-cell">Endkontrolle</td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr style="height:5.4mm;" class="m-orange"><td class="m-cell m-bold" colspan="5">Prüfung</td></tr>
                        <tr style="height:14.8mm;"><td class="m-cell">Mechanische Prüfung</td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr style="height:14.8mm;"><td class="m-cell">Elektrische Prüfung</td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr style="height:7.8mm;"><td class="m-cell">Meldung Versandfertig</td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr style="height:54mm;"><td class="m-cell">Bemerkungen</td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td><td class="m-cell"></td></tr>
                    </table>
                </div>
            </t>
        </xpath>

        <!-- Prüfprotokoll Fertigung: eigene feste A4-Geometrie -->
        <xpath expr="//t[@t-elif=&quot;doc.document_type == 'production_test'&quot;]" position="replace">
            <t t-elif="doc.document_type == 'production_test'">
                <div class="sab-master-page" style="font-size:8.2pt; line-height:1.02;">
                    <table style="margin-bottom:2mm;">
                        <colgroup><col style="width:47mm;"/><col style="width:88mm;"/><col style="width:55mm;"/></colgroup>
                        <tr><td colspan="2" style="font-size:18pt; font-weight:700; padding:0 0 1.5mm 0;">Prüfprotokoll der Fertigung</td><td rowspan="4" style="text-align:right; vertical-align:top; padding:0;"><img t-if="doc.project_id.company_id.logo" t-att-src="image_data_uri(doc.project_id.company_id.logo)" class="m-logo"/><div t-if="not doc.project_id.company_id.logo" style="font-size:24pt; font-weight:700;">SAB-P</div></td></tr>
                        <tr><td style="padding:0.3mm 0;">Kunde:</td><td class="m-cell" style="height:5.4mm;"><span t-out="doc.customer_name or ''"/></td></tr>
                        <tr><td style="padding:0.3mm 0;">Auftragsnr./Komission:</td><td class="m-cell" style="height:5.4mm;"><span t-out="doc.project_reference or ''"/> - <span t-out="doc.project_name or ''"/></td></tr>
                        <tr><td style="padding:0.3mm 0;">Verteiler:</td><td class="m-cell" style="height:5.4mm;"><span t-out="doc.cabinet_instance_label or doc.cabinet_name or ''"/></td></tr>
                    </table>
                    <table>
                        <colgroup><col style="width:12mm;"/><col style="width:86mm;"/><col style="width:23mm;"/><col style="width:69mm;"/></colgroup>
                        <tr style="height:8.5mm;"><th class="m-cell" colspan="2" style="text-align:left; font-size:10pt;">Durchgeführte Prüfungen</th><th class="m-cell" colspan="2" style="text-align:left;">Legende<br/><span style="font-weight:400; font-size:7pt;">iO - in Ordnung | niO - nicht in Ordnung | nr - nicht relevant</span></th></tr>
                        <tr><th class="m-cell">1.)</th><th class="m-cell" style="text-align:left;">Sichtprüfung</th><th class="m-cell">Ergebnis</th><th class="m-cell" style="text-align:left;">Bemerkung<br/><span style="font-weight:400; font-size:6.7pt;">Nur bei Abweichung/Einschränkung ausfüllen</span></th></tr>
                        <tr><td class="m-cell">1.0</td><td class="m-cell">Schranktyp bzw. mechanische Schäden</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.1</td><td class="m-cell">Verschlusssystem</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.2</td><td class="m-cell">Beflanschung bzw. M-Verschraubungen</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.3</td><td class="m-cell">Gerätebeschriftungen / Bezeichnungsschilder</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.4</td><td class="m-cell">Leitungsfarben Hauptstromkreise</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.5</td><td class="m-cell">Leitungsfarben Steuerstromkreise</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.6</td><td class="m-cell">PE-Leiter, Leitungsfarben, Führung</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.7</td><td class="m-cell">Gerätebestückung entspr. Zeichnung / Stückliste</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><th class="m-cell">2.)</th><th class="m-cell" style="text-align:left;">Mechanische Prüfung</th><th class="m-cell">Ergebnis</th><th class="m-cell" style="text-align:left;">Bemerkung<br/><span style="font-weight:400; font-size:6.7pt;">Nur bei Abweichung/Einschränkung ausfüllen</span></th></tr>
                        <tr><td class="m-cell">2.0</td><td class="m-cell">Betätigungselemente</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">2.1</td><td class="m-cell">Türkupplungen</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">2.2</td><td class="m-cell">Schraubverbindungen/Geräteeinbau (Stichproben)</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">2.3</td><td class="m-cell">Leitungsführung / Befestigung (nicht über Kanten)</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><th class="m-cell">3.)</th><th class="m-cell" style="text-align:left;">Elektrische Prüfung mit Nennspannung</th><th class="m-cell">Ergebnis</th><th class="m-cell" style="text-align:left;">Bemerkung<br/><span style="font-weight:400; font-size:6.7pt;">Nur bei Abweichung/Einschränkung ausfüllen</span></th></tr>
                        <tr><td class="m-cell">3.0</td><td class="m-cell">Hauptstromkreise entspr. Stromlaufplan</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">3.1</td><td class="m-cell">Steuerstromkreise entspr. Stromlaufplan</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">3.2</td><td class="m-cell">Ein-/Ausgänge mit PG überprüft (bei SPS-Steuerung)</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">3.3</td><td class="m-cell">Leuchtmelder</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">3.4</td><td class="m-cell">Einhaltung der Isolationswiderstände (&gt;200MΩ)</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><th class="m-cell">4.)</th><th class="m-cell" style="text-align:left;">Überprüfung der Maßnahmen zum Schutz bei direktem und indirektem Berühren</th><th class="m-cell">Ergebnis</th><th class="m-cell" style="text-align:left;">Bemerkung<br/><span style="font-weight:400; font-size:6.7pt;">Nur bei Abweichung/Einschränkung ausfüllen</span></th></tr>
                        <tr><td class="m-cell">4.0</td><td class="m-cell">Anordnung der Betätigungselemente</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">4.1</td><td class="m-cell">Überprüfung der Gehäuse, Abdeckungen</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">4.2</td><td class="m-cell">Überprüfung der Schutzleiterbahnen und deren Verbindungen, insbesondere an leitenden Konstruktionsteilen, Bedienteilen etc.</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">4.3</td><td class="m-cell">Überprüfung der Schutzisolierung auf mechanische Beanspruchung</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><th class="m-cell">5.)</th><th class="m-cell" style="text-align:left;">Überprüfung der zum Erreichen der Schutzart vorgesehenen Maßnahmen</th><th class="m-cell">Ergebnis</th><th class="m-cell" style="text-align:left;">Bemerkung<br/><span style="font-weight:400; font-size:6.7pt;">Nur bei Abweichung/Einschränkung ausfüllen</span></th></tr>
                        <tr><td class="m-cell">5.0</td><td class="m-cell">Kabeleinführungen/Dichtungen/Verschlüsse etc.</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><th class="m-cell">6.)</th><th class="m-cell" style="text-align:left;">Endkontrolle</th><th class="m-cell">Ergebnis</th><th class="m-cell" style="text-align:left;">Bemerkung<br/><span style="font-weight:400; font-size:6.7pt;">Nur bei Abweichung/Einschränkung ausfüllen</span></th></tr>
                        <tr><td class="m-cell">6.0</td><td class="m-cell">Anlage gereinigt</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">6.1</td><td class="m-cell">Schaltpläne, Bedienungsanleitungen beigefügt</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">6.2</td><td class="m-cell">Versandbereitschaft</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                    </table>
                    <table style="width:166mm; margin:4mm auto 0 auto;">
                        <colgroup><col style="width:40mm;"/><col style="width:27mm;"/><col style="width:18mm;"/><col style="width:43mm;"/><col style="width:38mm;"/></colgroup>
                        <tr><th class="m-cell" colspan="5" style="text-align:left;">Messwerte der Isolationsmessung</th></tr>
                        <tr><td class="m-cell">Prüfspannung Vtest:</td><td class="m-cell"><span t-out="doc.test_voltage or ''"/></td><td class="m-cell m-bold m-center">V</td><td class="m-cell">Ergebnis Riso:</td><td class="m-cell m-bold m-right"><span t-out="doc.insulation_resistance or ''"/> MOhm</td></tr>
                        <tr><th class="m-cell" colspan="5" style="text-align:left;">Durchgängigkeit des Schutzleiters</th></tr>
                        <tr><td class="m-cell">Ergebnis Rpe:</td><td class="m-cell"><span t-out="doc.protective_conductor_resistance or ''"/></td><td class="m-cell m-bold m-center">Ohm</td><td class="m-cell" colspan="2"></td></tr>
                    </table>
                    <div style="margin-top:5mm; border-top:0.35mm solid #000; padding-top:5mm; font-size:10pt; font-weight:700;">Wermelskirchen/</div>
                    <table style="margin-top:5mm;"><tr><td style="width:47%; border-top:0.35mm solid #000; padding-top:1mm;">Ort / Datum</td><td style="width:6%;"></td><td style="width:47%; border-top:0.35mm solid #000; padding-top:1mm;">Kennung/Name des Prüfers</td></tr></table>
                    <div class="m-footer" style="border-top:0.25mm solid #000; padding-top:1mm;"><span>SP_PRF-PR_D2</span><span style="float:right;">Copyright © 2018 SAB-P GmbH - Alle Rechte vorbehalten</span></div>
                </div>
            </t>
        </xpath>

        <!-- Prüfprotokoll Endkontrolle: komplett eigene Seite -->
        <xpath expr="//t[@t-elif=&quot;doc.document_type == 'final_inspection'&quot;]" position="replace">
            <t t-elif="doc.document_type == 'final_inspection'">
                <div class="sab-master-page" style="font-size:8.3pt; line-height:1.02;">
                    <table style="margin-bottom:2mm;">
                        <colgroup><col style="width:47mm;"/><col style="width:88mm;"/><col style="width:55mm;"/></colgroup>
                        <tr><td colspan="2" style="font-size:18pt; font-weight:700; padding:0 0 1.5mm 0;">Prüfprotokoll Endkontrolle</td><td rowspan="4" style="text-align:right; vertical-align:top; padding:0;"><img t-if="doc.project_id.company_id.logo" t-att-src="image_data_uri(doc.project_id.company_id.logo)" class="m-logo"/><div t-if="not doc.project_id.company_id.logo" style="font-size:24pt; font-weight:700;">SAB-P</div></td></tr>
                        <tr><td style="padding:0.3mm 0;">Kunde:</td><td class="m-cell" style="height:5.4mm;"><span t-out="doc.customer_name or ''"/></td></tr>
                        <tr><td style="padding:0.3mm 0;">Auftragsnr./Komission:</td><td class="m-cell" style="height:5.4mm;"><span t-out="doc.project_reference or ''"/> - <span t-out="doc.project_name or ''"/></td></tr>
                        <tr><td style="padding:0.3mm 0;">Verteiler:</td><td class="m-cell" style="height:5.4mm;"><span t-out="doc.cabinet_instance_label or doc.cabinet_name or ''"/></td></tr>
                    </table>
                    <table>
                        <colgroup><col style="width:12mm;"/><col style="width:86mm;"/><col style="width:23mm;"/><col style="width:69mm;"/></colgroup>
                        <tr><th class="m-cell" colspan="2" style="text-align:left; font-size:10pt; height:9mm;">Durchgeführte Kontrollen</th><th class="m-cell"></th><th class="m-cell"></th></tr>
                        <tr><th class="m-cell">1.)</th><th class="m-cell" style="text-align:left;">Mechanische Kontrolle</th><th class="m-cell" style="text-align:left;">Prüfer<br/>(Kürzel)</th><th class="m-cell" style="text-align:left;">Bemerkung<br/><span style="font-weight:400; font-size:6.7pt;">Nur bei Abweichung/Einschränkung ausfüllen</span></th></tr>
                        <tr><td class="m-cell">1.0</td><td class="m-cell">Anziehmomente der Schraubverbindungen geprüft (Stichproben)</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.1</td><td class="m-cell">Hochstrom-Verbindungen gekennzeichnet</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.2</td><td class="m-cell">Sicherungseinsätze eingebaut<br/>(sofern erforderlich)</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.3</td><td class="m-cell">Schaltplantasche eingebaut</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.4</td><td class="m-cell">Abdeckungen komplett eingebaut</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.5</td><td class="m-cell">Kennzeichnung aller Geräte</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.6</td><td class="m-cell">Transporttrennung entsprechend der Vorgabe eingehalten (sofern erforderlich)</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.7</td><td class="m-cell">Schutzklasse SK I/II entsprechend der Vorgabe eingehalten</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><td class="m-cell">1.8</td><td class="m-cell">Schutzart IPxx entsprechend der Vorgabe eingehalten</td><td class="m-cell"></td><td class="m-cell"></td></tr>
                        <tr><th class="m-cell">2.)</th><th class="m-cell" style="text-align:left;">Elektrische Kontrolle</th><th class="m-cell" style="text-align:left;">Prüfer<br/>(Kürzel)</th><th class="m-cell" style="text-align:left;">Bemerkung<br/><span style="font-weight:400; font-size:6.7pt;">Nur bei Abweichung/Einschränkung ausfüllen</span></th></tr>
