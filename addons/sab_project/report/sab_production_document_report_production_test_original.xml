        <field name="report_name">sab_project.report_sab_production_test_studio</field>
        <field name="report_file">sab_project.report_sab_production_test_studio</field>
        <field name="paperformat_id" ref="paperformat_sab_production_test_studio"/>
        <field name="print_report_name">object._sab_pdf_filename()</field>
    </record>

