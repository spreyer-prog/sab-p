    <!-- Eigenständige, in Odoo Studio bearbeitbare Ausgabe. -->
    <record id="paperformat_sab_production_test_studio" model="report.paperformat">
        <field name="name">SAB-P Prüfprotokoll Fertigung 210 x 297 mm</field>
        <field name="format">custom</field>
        <field name="page_width">210</field>
        <field name="page_height">297</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sab_production_test_studio" model="ir.actions.report">
