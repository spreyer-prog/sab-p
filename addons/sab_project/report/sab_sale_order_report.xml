<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sab_report_saleorder_document" inherit_id="sale.report_saleorder_document">
        <!-- Sobald eine SAB-P Kalkulation vorhanden ist, ersetzt sie die normalen
             Odoo-Auftragspositionen im Angebotsdruck. Interne Positionen eines
             Bauteils bleiben verborgen; gedruckt wird nur der Gruppenpreis. -->
        <xpath expr="//table[contains(@class, 'o_main_table')]" position="attributes">
            <attribute name="t-if">not doc.sab_calculation_line_ids</attribute>
        </xpath>

        <xpath expr="//table[contains(@class, 'o_main_table')]" position="after">
            <table t-if="doc.sab_calculation_line_ids" class="o_has_total_table table o_main_table table-borderless">
                <thead style="display: table-row-group">
                    <tr>
                        <th class="text-start" style="width: 7%;">Pos.</th>
                        <th class="text-start">Beschreibung</th>
                        <th class="text-end text-nowrap" style="width: 12%;">Menge</th>
                        <th class="text-end text-nowrap" style="width: 16%;">Einzelpreis</th>
                        <th class="text-end text-nowrap" style="width: 16%;">Gesamtpreis</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="sab_pos" t-value="0"/>

                    <t t-foreach="doc.sab_calculation_group_ids.sorted(key=lambda g: (g.sequence, g.id))" t-as="group">
                        <t t-if="group.line_ids">
                            <t t-set="sab_pos" t-value="sab_pos + 1"/>
                            <tr class="fw-bold">
                                <td class="text-start"><span t-out="sab_pos"/></td>
                                <td class="text-start">
                                    <span t-field="group.name"/>
                                    <div t-if="group.description" class="fw-normal mt-1">
                                        <span t-field="group.description"/>
                                    </div>
                                </td>
                                <td class="text-end text-nowrap">1,00</td>
                                <td class="text-end text-nowrap">
                                    <span t-out="group.group_net_price" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-out="group.group_net_price" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>

                    <t t-foreach="doc.sab_calculation_line_ids.filtered(lambda l: not l.group_id).sorted(key=lambda l: (l.sequence, l.id))" t-as="line">
                        <t t-set="sab_pos" t-value="sab_pos + 1"/>
                        <tr>
                            <td class="text-start"><span t-out="sab_pos"/></td>
                            <td class="text-start">
                                <span t-out="line.description or line.calculation_item_id.quotation_text or line.calculation_item_id.name"/>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-out="line.quantity" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-out="line.unit_recommended_net_price" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                            </td>
                            <td class="text-end text-nowrap">
                                <span t-out="line.recommended_net_price" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </xpath>

        <xpath expr="//div[@name='so_total_summary']" position="attributes">
            <attribute name="t-if">not doc.sab_calculation_line_ids</attribute>
        </xpath>

        <xpath expr="//div[@name='so_total_summary']" position="after">
            <div t-if="doc.sab_calculation_line_ids" class="clearfix" name="sab_total_summary">
                <div class="row mt-2">
                    <div t-attf-class="# {'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                        <table class="o_total_table table table-borderless">
                            <tr class="fw-bold border-top">
                                <td class="text-start">Netto-Angebotssumme</td>
                                <td class="text-end">
                                    <span t-out="doc.sab_offer_net_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
