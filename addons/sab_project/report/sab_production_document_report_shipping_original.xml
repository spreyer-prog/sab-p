<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sab_production_document_shipping_original"
              inherit_id="sab_project.report_sab_production_document"
              priority="2130">
        <xpath expr="//t[@t-elif=&quot;doc.document_type == 'shipping_sheet'&quot;]" position="replace">
            <t t-elif="doc.document_type == 'shipping_sheet'" t-translation="off">
                <!-- Blatt Versand.pdf: A4 mit 90° Seitendrehung = effektives A4 Querformat. -->
                <div style="position:relative; width:297mm; height:210mm; margin:0; padding:0; font-family:Arial,Helvetica,sans-serif; color:#000; overflow:hidden; box-sizing:border-box;">
                    <div style="position:absolute; left:30.8mm; top:27.0mm; width:235.4mm; height:156.0mm; border:0.35mm solid #000; box-sizing:border-box; text-align:center; font-weight:700; overflow:hidden;">
                        <div style="position:absolute; top:9mm; left:4mm; right:4mm; font-size:25pt; line-height:1.0;"><span t-out="doc.project_reference or ''"/></div>
                        <div style="position:absolute; top:43mm; left:4mm; right:4mm; font-size:24pt; line-height:1.0;"><span t-out="doc.customer_name or ''"/></div>
                        <div style="position:absolute; top:79mm; left:4mm; right:4mm; font-size:24pt; line-height:1.0;"><span t-out="doc.project_name or ''"/></div>
                        <div style="position:absolute; top:116mm; left:4mm; right:4mm; font-size:24pt; line-height:1.0;"><span t-out="doc.cabinet_instance_label or doc.cabinet_name or ''"/></div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Eigenständige, in Odoo Studio bearbeitbare Ausgabe. -->
    <record id="paperformat_sab_shipping_sheet_studio" model="report.paperformat">
        <field name="name">SAB-P Versandblatt 297 x 210 mm</field>
        <field name="format">custom</field>
        <field name="page_width">210</field>
        <field name="page_height">297</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sab_shipping_sheet_studio" model="ir.actions.report">
        <field name="name">SAB-P Versandblatt (Studio)</field>
        <field name="model">sab.production.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sab_project.report_sab_shipping_sheet_studio</field>
        <field name="report_file">sab_project.report_sab_shipping_sheet_studio</field>
        <field name="paperformat_id" ref="paperformat_sab_shipping_sheet_studio"/>
        <field name="print_report_name">object._sab_pdf_filename()</field>
    </record>

    <template id="report_sab_shipping_sheet_studio">
        <t t-call="web.html_container">
            <t t-call="sab_project.report_sab_studio_pdf_reset"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="sab_project.report_sab_shipping_sheet_studio_page"/>
            </t>
        </t>
    </template>

    <template id="report_sab_shipping_sheet_studio_page">
        <div class="page" name="sab_shipping_sheet_studio_page" t-translation="off" style="margin:0; padding:0;">
                <!-- Blatt Versand.pdf: A4 mit 90° Seitendrehung = effektives A4 Querformat. -->
                <div style="position:relative; width:297mm; height:210mm; margin:0; padding:0; font-family:Arial,Helvetica,sans-serif; color:#000; overflow:hidden; box-sizing:border-box;">
                    <div style="position:absolute; left:30.8mm; top:27.0mm; width:235.4mm; height:156.0mm; border:0.35mm solid #000; box-sizing:border-box; text-align:center; font-weight:700; overflow:hidden;">
                        <div style="position:absolute; top:9mm; left:4mm; right:4mm; font-size:25pt; line-height:1.0;"><span t-out="doc.project_reference or ''"/></div>
                        <div style="position:absolute; top:43mm; left:4mm; right:4mm; font-size:24pt; line-height:1.0;"><span t-out="doc.customer_name or ''"/></div>
                        <div style="position:absolute; top:79mm; left:4mm; right:4mm; font-size:24pt; line-height:1.0;"><span t-out="doc.project_name or ''"/></div>
                        <div style="position:absolute; top:116mm; left:4mm; right:4mm; font-size:24pt; line-height:1.0;"><span t-out="doc.cabinet_instance_label or doc.cabinet_name or ''"/></div>
                    </div>
                </div>
        </div>
    </template>

</odoo>
