<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sab_production_document_info_sheet_original"
              inherit_id="sab_project.report_sab_production_document"
              priority="2150">
        <xpath expr="//t[@t-elif=&quot;doc.document_type == 'info_sheet'&quot;]" position="replace">
            <t t-elif="doc.document_type == 'info_sheet'" t-translation="off">
                <!-- Geprüfter SAB-P-Ausgabeträger: 265 x 176 mm Querformat. -->
                <div style="position:relative; width:265mm; height:176mm; margin:0; padding:0; overflow:hidden; font-family:'Arial Narrow','Liberation Sans Narrow',Arial,Helvetica,sans-serif; color:#000; box-sizing:border-box;">
                    <div style="position:absolute; width:265mm; height:176mm; left:0; top:0; transform:none; transform-origin:top left;">
                        <table style="height:176mm; width:265mm; border-left:0.8mm double #000; border-right:0.8mm double #000; table-layout:fixed; border-collapse:collapse;">
                            <colgroup><col style="width:72mm;"/><col style="width:72mm;"/><col style="width:121mm;"/></colgroup>
                            <tr>
                                <td style="border-right:0.35mm solid #000; padding:4mm; vertical-align:top;">
                                    <div style="height:39mm; display:flex; align-items:center; justify-content:center;">
                                        <img t-att-src="doc._sab_report_logo_src()" style="max-width:62mm; max-height:29mm; object-fit:contain;"/>
                                    </div>
                                    <div style="font-size:8.5pt; line-height:1.12; text-align:center; margin-top:1mm; font-weight:700;">SAB-P GmbH<br/>Schaltanlagenbau Preyer<br/>Albert-Einstein-Str. 7a<br/>42929 Wermelskirchen<br/><span style="font-size:7pt; font-weight:400;">Tel. 02196 90901-0 - FAX -99</span></div>
                                    <div style="border-top:0.35mm solid #000; margin:4mm 0 4mm 0;"></div>
                                    <div style="font-size:10.5pt; font-weight:700; line-height:1.08; text-align:center;">Wartung und Prüfung von ortsfesten Anlagen nach DGUV Vorschrift 3<br/>und DIN VDE 0100</div>
                                    <div style="font-size:10pt; font-weight:700; margin-top:7mm;">Nächster vorgeschlagener<br/>Wartungstermin:</div>
                                    <div style="width:45mm; min-height:31mm; border:0.35mm solid #777; margin:6mm auto 0 auto; display:flex; align-items:center; justify-content:center; font-size:15pt; font-weight:700;"><span t-if="doc.next_maintenance_date" t-field="doc.next_maintenance_date" t-options='{"widget":"date","format":"dd.MM.yyyy"}'/></div>
                                    <div style="font-size:20pt; font-weight:700; text-align:center; margin-top:11mm;">Tel: 02196 90901 0</div>
                                </td>
                                <td style="border-right:0.35mm solid #000; padding:4mm; vertical-align:top;">
                                    <div style="font-size:11.5pt; font-weight:700; margin-top:4mm;">Prüfung:</div>
                                    <div style="border:0.35mm solid #aaa; margin-top:8mm; min-height:62mm; padding:7mm 5mm; box-sizing:border-box;">
                                        <div style="font-size:19pt; font-weight:700; text-align:center;">Geprüft</div>
                                        <div style="font-size:9.5pt; margin-top:9mm;">Name : <strong><span t-out="doc.inspector_name or ''"/></strong></div>
                                        <div style="font-size:9.5pt; margin-top:6mm;">Datum: <strong><span t-if="doc.inspection_date" t-field="doc.inspection_date" t-options='{"widget":"date","format":"dd.MM.yyyy"}'/></strong></div>
                                    </div>
                                </td>
                                <td style="padding:0; vertical-align:top;">
                                    <table style="height:176mm; width:121mm; table-layout:fixed; border-collapse:collapse; font-size:9pt;">
                                        <colgroup><col style="width:30mm;"/><col style="width:42mm;"/><col style="width:49mm;"/></colgroup>
                                        <tr>
                                            <td style="border-right:0.35mm solid #000; padding:5mm 3mm; vertical-align:top;"><div style="font-size:10.5pt; font-weight:700; line-height:1.05; margin-bottom:8mm;">Information zum<br/>Überspannungschutz:</div><div style="line-height:1.1;">Nachfolgende Information sind für Anlagen mit Überspannungselementen zu beachten!</div></td>
                                            <td style="border-right:0.35mm solid #000; padding:5mm 3mm; vertical-align:top;"><div style="font-size:10pt; font-weight:700; line-height:1.12;">Bei Isolationsmessungen<br/>bitte die Schutzmodule<br/>abziehen bzw. abklemmen.</div><div style="font-size:8.7pt; line-height:1.1; margin-top:10mm;">System contains overvolting protection devices.</div></td>
                                            <td style="padding:5mm 3mm; vertical-align:top;"><div style="font-size:10.5pt; font-weight:700; line-height:1.12;">Please remove or<br/>disconnect the protectors<br/>during isolation tests.</div></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Eigenständige, in Odoo Studio bearbeitbare Ausgabe. -->
    <record id="paperformat_sab_info_sheet_studio" model="report.paperformat">
        <field name="name">SAB-P Infoschild 265 x 176 mm</field>
        <field name="format">custom</field>
        <field name="page_width">176</field>
        <field name="page_height">265</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sab_info_sheet_studio" model="ir.actions.report">
        <field name="name">SAB-P Infoschild (Studio)</field>
        <field name="model">sab.production.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sab_project.report_sab_info_sheet_studio</field>
        <field name="report_file">sab_project.report_sab_info_sheet_studio</field>
        <field name="paperformat_id" ref="paperformat_sab_info_sheet_studio"/>
        <field name="print_report_name">object._sab_pdf_filename()</field>
    </record>

    <template id="report_sab_info_sheet_studio">
        <t t-call="web.html_container">
            <t t-call="sab_project.report_sab_studio_pdf_reset"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="sab_project.report_sab_info_sheet_studio_page"/>
            </t>
        </t>
    </template>

