<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sab_production_document_missing_parts_original"
              inherit_id="sab_project.report_sab_production_document"
              priority="2160">
        <xpath expr="//t[@t-elif=&quot;doc.document_type == 'missing_parts'&quot;]" position="replace">
            <t t-elif="doc.document_type == 'missing_parts'" t-translation="off">
                <!-- Bestelvorlage.pdf: A4 mit 90° Rotation = A4 Querformat. -->
                <div style="position:relative; width:297mm; height:210mm; margin:0; padding:0; overflow:hidden; font-family:Arial,Helvetica,sans-serif; color:#000; box-sizing:border-box;">
                    <div style="position:absolute; left:19.8mm; top:24.8mm; width:255.2mm; height:151.1mm; box-sizing:border-box; font-size:5.2pt; line-height:1.0;">
                        <div style="height:5.4mm; border:0.18mm solid #000; display:flex; align-items:center; justify-content:center; font-size:6.8pt; font-weight:700;">Bestellung Fehlteile</div>
                        <div style="height:5.2mm; background:#00f10a; border-left:0.18mm solid #000; border-right:0.18mm solid #000; border-bottom:0.18mm solid #000;"></div>
                        <div style="height:6.0mm; border-left:0.18mm solid #000; border-right:0.18mm solid #000; border-bottom:0.18mm solid #000; display:flex; align-items:center; justify-content:center; font-size:7.5pt; font-weight:700;">**</div>
                        <table style="border-collapse:collapse; table-layout:fixed; width:255.2mm; margin-top:1.5mm;">
                            <colgroup><col style="width:47mm;"/><col style="width:105mm;"/><col style="width:68mm;"/><col style="width:35.2mm;"/></colgroup>
                            <tr style="height:5.5mm; font-size:5.4pt; font-weight:700;"><td style="border:0; padding:0.3mm 0.5mm;"><span t-out="doc.project_reference or ''"/></td><td style="border:0; padding:0.3mm 0.5mm;"><span t-out="doc.project_name or ''"/></td><td colspan="2" style="border:0; padding:0.3mm 0.5mm; text-align:center;"><span t-out="doc.customer_name or ''"/></td></tr>
                            <tr style="height:4.2mm; font-size:4.5pt; background:#d0d0d0;"><td>Verteiler</td><td>Artikelnummer / Artikeltext</td><td>Bemerkung</td><td>Erledigt/Datum</td></tr>
                            <t t-foreach="range(18)" t-as="i"><tr style="height:5.7mm;"><td><span t-if="i == 0" t-out="doc.cabinet_instance_label or doc.cabinet_name or ''"/></td><td></td><td></td><td style="text-align:center;"><span style="font-size:4.2pt;">○</span></td></tr></t>
                        </table>
                    </div>
                    <style>
                        #wrapwrap table td, #wrapwrap table th { border:0.14mm solid #000; padding:0.25mm 0.5mm; vertical-align:middle; box-sizing:border-box; }
                    </style>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Eigenständige, in Odoo Studio bearbeitbare Ausgabe. -->
    <record id="paperformat_sab_missing_parts_studio" model="report.paperformat">
        <field name="name">SAB-P Bestellung Fehlteile 297 x 210 mm</field>
        <field name="format">custom</field>
        <field name="page_width">210</field>
        <field name="page_height">297</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sab_missing_parts_studio" model="ir.actions.report">
        <field name="name">SAB-P Bestellung Fehlteile (Studio)</field>
        <field name="model">sab.production.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sab_project.report_sab_missing_parts_studio</field>
        <field name="report_file">sab_project.report_sab_missing_parts_studio</field>
        <field name="paperformat_id" ref="paperformat_sab_missing_parts_studio"/>
        <field name="print_report_name">object._sab_pdf_filename()</field>
    </record>

    <template id="report_sab_missing_parts_studio">
        <t t-call="web.html_container">
            <t t-call="sab_project.report_sab_studio_pdf_reset"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="sab_project.report_sab_missing_parts_studio_page"/>
            </t>
        </t>
    </template>

    <template id="report_sab_missing_parts_studio_page">
        <div class="page" name="sab_missing_parts_studio_page" t-translation="off" style="margin:0; padding:0;">
                <!-- Bestelvorlage.pdf: A4 mit 90° Rotation = A4 Querformat. -->
                <div style="position:relative; width:297mm; height:210mm; margin:0; padding:0; overflow:hidden; font-family:Arial,Helvetica,sans-serif; color:#000; box-sizing:border-box;">
                    <div style="position:absolute; left:19.8mm; top:24.8mm; width:255.2mm; height:151.1mm; box-sizing:border-box; font-size:5.2pt; line-height:1.0;">
                        <div style="height:5.4mm; border:0.18mm solid #000; display:flex; align-items:center; justify-content:center; font-size:6.8pt; font-weight:700;">Bestellung Fehlteile</div>
                        <div style="height:5.2mm; background:#00f10a; border-left:0.18mm solid #000; border-right:0.18mm solid #000; border-bottom:0.18mm solid #000;"></div>
                        <div style="height:6.0mm; border-left:0.18mm solid #000; border-right:0.18mm solid #000; border-bottom:0.18mm solid #000; display:flex; align-items:center; justify-content:center; font-size:7.5pt; font-weight:700;">**</div>
                        <table style="border-collapse:collapse; table-layout:fixed; width:255.2mm; margin-top:1.5mm;">
                            <colgroup><col style="width:47mm;"/><col style="width:105mm;"/><col style="width:68mm;"/><col style="width:35.2mm;"/></colgroup>
                            <tr style="height:5.5mm; font-size:5.4pt; font-weight:700;"><td style="border:0; padding:0.3mm 0.5mm;"><span t-out="doc.project_reference or ''"/></td><td style="border:0; padding:0.3mm 0.5mm;"><span t-out="doc.project_name or ''"/></td><td colspan="2" style="border:0; padding:0.3mm 0.5mm; text-align:center;"><span t-out="doc.customer_name or ''"/></td></tr>
                            <tr style="height:4.2mm; font-size:4.5pt; background:#d0d0d0;"><td>Verteiler</td><td>Artikelnummer / Artikeltext</td><td>Bemerkung</td><td>Erledigt/Datum</td></tr>
                            <t t-foreach="range(18)" t-as="i"><tr style="height:5.7mm;"><td><span t-if="i == 0" t-out="doc.cabinet_instance_label or doc.cabinet_name or ''"/></td><td></td><td></td><td style="text-align:center;"><span style="font-size:4.2pt;">○</span></td></tr></t>
                        </table>
                    </div>
                    <style>
                        #wrapwrap table td, #wrapwrap table th { border:0.14mm solid #000; padding:0.25mm 0.5mm; vertical-align:middle; box-sizing:border-box; }
                    </style>
                </div>
        </div>
    </template>

</odoo>
