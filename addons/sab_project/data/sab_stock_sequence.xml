<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_sab_stock_movement" model="ir.sequence">
        <field name="name">SAB-P Lagerbewegung</field>
        <field name="code">sab.stock.movement</field>
        <field name="prefix">LB%(y)s-</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_sab_purchase_order" model="ir.sequence">
        <field name="name">SAB-P Lieferantenbestellung</field>
        <field name="code">sab.purchase.order</field>
        <field name="prefix">BE%(y)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
