<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_purchase_requirement_list" model="ir.ui.view">
        <field name="name">sab.purchase.requirement.list</field>
        <field name="model">sab.purchase.requirement</field>
        <field name="arch" type="xml">
            <list string="Einkaufsbedarf">
                <field name="name"/>
                <field name="project_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="unit"/>
                <field name="supplier_id"/>
                <field name="supplier_product_id" optional="show"/>
                <field name="unit_purchase_price" optional="show"/>
                <field name="purchase_total" optional="show"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_sab_purchase_requirement_form" model="ir.ui.view">
        <field name="name">sab.purchase.requirement.form</field>
        <field name="model">sab.purchase.requirement</field>
        <field name="arch" type="xml">
            <form string="SAB-P Einkaufsbedarf">
                <header>
                    <button name="action_mark_ordered" type="object" string="Als bestellt markieren" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_mark_received" type="object" string="Als geliefert markieren" class="btn-primary" invisible="state not in ('open', 'ordered')"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,ordered,received"/>
                </header>
                <sheet>
                    <group col="4">
                        <field name="name" readonly="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="order_id" readonly="1"/>
                        <field name="bom_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="quantity" readonly="1"/>
                        <field name="unit" readonly="1"/>
                        <field name="supplier_id" readonly="1"/>
                        <field name="supplier_product_id" readonly="1"/>
                        <field name="unit_purchase_price" readonly="1"/>
                        <field name="purchase_total" readonly="1"/>
                        <field name="optional" readonly="1"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sab_purchase_requirement" model="ir.actions.act_window">
        <field name="name">Einkaufsbedarf</field>
        <field name="res_model">sab.purchase.requirement</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sab_purchase_requirement_menu" name="Einkaufsbedarf" parent="sab_calculation_root_menu" action="action_sab_purchase_requirement" sequence="110"/>
</odoo>
