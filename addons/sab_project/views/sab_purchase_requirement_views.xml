<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_purchase_requirement_list" model="ir.ui.view">
        <field name="name">sab.purchase.requirement.list</field>
        <field name="model">sab.purchase.requirement</field>
        <field name="arch" type="xml">
            <list string="Einkaufsbedarf"
                  create="0"
                  delete="0"
                  decoration-success="stock_status == 'in_stock' or stock_status == 'received'"
                  decoration-warning="stock_status in ('partial', 'proposal', 'approval', 'approved', 'ordered', 'partial_received')"
                  decoration-danger="stock_status == 'missing'">
                <header>
                    <button name="action_create_purchase_orders"
                            type="object"
                            string="Bestellung aus Auswahl erzeugen"
                            invisible="1"
                            groups="sab_project.group_sab_purchasing"/>
                    <button name="action_create_standard_purchase_orders_from_selection"
                            type="object"
                            string="Bestellvorschlag aus markierten Positionen"
                            class="btn-primary"
                            display="always"
                            groups="sab_project.group_sab_purchasing"/>
                </header>
                <field name="project_id"/>
                <field name="sequence" string="Pos." optional="show"/>
                <field name="manufacturer_name" string="Hersteller" optional="show"/>
                <field name="odoo_product_id" string="Produkt" optional="show"/>
                <field name="product_id" string="Produkt (Altbestand)" optional="hide"/>
                <field name="quantity" string="Bedarf"/>
                <field name="unit"/>
                <field name="warehouse_on_hand" string="Lager gesamt" optional="show"/>
                <field name="project_reserved_quantity" string="Für Projekt reserviert" optional="show"/>
                <field name="shortage_quantity" string="Fehlbestand" optional="show"/>
                <field name="suggested_order_quantity" string="Bestellvorschlag" optional="show"/>
                <field name="supplier_id" string="Lieferant"/>
                <field name="supplier_product_id" optional="hide"/>
                <field name="unit_purchase_price" optional="hide"/>
                <field name="purchase_total" optional="hide"/>
                <field name="stock_status" string="Materialstatus" widget="badge"/>
                <field name="purchase_order_id" string="Bestellung" optional="show"/>
                <field name="purchase_order_state" string="Bestellstatus" optional="hide"/>
                <field name="state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sab_purchase_requirement_search" model="ir.ui.view">
        <field name="name">sab.purchase.requirement.search</field>
        <field name="model">sab.purchase.requirement</field>
        <field name="arch" type="xml">
            <search string="Einkaufsbedarf">
                <field name="project_id"/>
                <field name="odoo_product_id"/>
                <field name="supplier_id"/>
                <field name="purchase_order_id"/>
                <separator/>
                <filter name="open" string="Offen" domain="[('state','=','open')]"/>
                <filter name="not_ordered" string="Noch ohne Bestellvorschlag" domain="[('state','=','open'),('purchase_order_line_id','=',False)]"/>
                <filter name="proposal" string="Bestellvorschlag / Freigabe" domain="[('purchase_order_state','in',('draft','to_approve','approved'))]"/>
                <filter name="ordered" string="Bestellt – Lieferung offen" domain="[('purchase_order_state','in',('sent','partial'))]"/>
                <filter name="received" string="Vollständig geliefert" domain="[('state','=','received')]"/>
                <group>
                    <filter name="group_project" string="Projekt" context="{'group_by':'project_id'}"/>
                    <filter name="group_supplier" string="Lieferant" context="{'group_by':'supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sab_purchase_requirement_form" model="ir.ui.view">
        <field name="name">sab.purchase.requirement.form</field>
        <field name="model">sab.purchase.requirement</field>
        <field name="arch" type="xml">
            <form string="SAB-P Einkaufsbedarf" create="0" delete="0">
                <sheet>
                    <group string="Projekt und Produkt" col="4">
                        <field name="name" readonly="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="order_id" readonly="1"/>
                        <field name="bom_id" readonly="1"/>
                        <field name="manufacturer_name" readonly="1"/>
                        <field name="odoo_product_id" readonly="1"/>
                        <field name="product_id" readonly="1" invisible="not product_id"/>
                        <field name="quantity" readonly="1"/>
                        <field name="unit" readonly="1"/>
                        <field name="optional" readonly="1"/>
                    </group>
                    <group string="Lagerprüfung" col="4">
                        <field name="warehouse_on_hand" readonly="1"/>
                        <field name="warehouse_reserved" readonly="1"/>
                        <field name="warehouse_available" readonly="1"/>
                        <field name="project_reserved_quantity" readonly="1"/>
                        <field name="shortage_quantity" readonly="1"/>
                        <field name="stock_status" readonly="1" widget="badge"/>
                    </group>
                    <group string="Beschaffung" col="4">
                        <field name="supplier_id" readonly="1"/>
                        <field name="supplier_product_id" readonly="1"/>
                        <field name="suggested_order_quantity" readonly="1"/>
                        <field name="unit_purchase_price" readonly="1"/>
                        <field name="purchase_total" readonly="1"/>
                        <field name="purchase_order_id" readonly="1"/>
                        <field name="purchase_order_state" readonly="1"/>
                        <field name="state" readonly="1"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sab_purchase_requirement" model="ir.actions.act_window">
        <field name="name">Einkaufsbedarf</field>
        <field name="res_model">sab.purchase.requirement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sab_purchase_requirement_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

    <menuitem id="sab_purchase_requirement_menu" name="Einkaufsbedarf" parent="sab_calculation_root_menu" action="action_sab_purchase_requirement" sequence="110"/>
</odoo>
