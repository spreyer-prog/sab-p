<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_project_controlling_list" model="ir.ui.view">
        <field name="name">sab.project.controlling.list</field>
        <field name="model">sab.project.controlling</field>
        <field name="arch" type="xml">
            <list string="Nachkalkulation">
                <field name="project_id"/>
                <field name="calculated_hours"/>
                <field name="actual_hours"/>
                <field name="hours_variance"/>
                <field name="hours_variance_percent"/>
                <field name="actual_labor_cost"/>
                <field name="material_issue_cost"/>
                <field name="actual_direct_cost"/>
                <field name="offer_amount"/>
                <field name="contribution_margin"/>
            </list>
        </field>
    </record>

    <record id="view_sab_project_controlling_form" model="ir.ui.view">
        <field name="name">sab.project.controlling.form</field>
        <field name="model">sab.project.controlling</field>
        <field name="arch" type="xml">
            <form string="SAB-P Nachkalkulation">
                <sheet>
                    <group string="Projekt">
                        <field name="project_id"/>
                    </group>
                    <group string="Zeit" col="4">
                        <field name="calculated_hours" readonly="1"/>
                        <field name="actual_hours" readonly="1"/>
                        <field name="hours_variance" readonly="1"/>
                        <field name="hours_variance_percent" readonly="1"/>
                    </group>
                    <group string="Kosten / Ergebnis" col="4">
                        <field name="actual_labor_cost" readonly="1"/>
                        <field name="material_issue_cost" readonly="1"/>
                        <field name="actual_direct_cost" readonly="1"/>
                        <field name="offer_amount" readonly="1"/>
                        <field name="contribution_margin" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sab_project_controlling" model="ir.actions.act_window">
        <field name="name">Nachkalkulation</field>
        <field name="res_model">sab.project.controlling</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sab_project_controlling_menu" name="Nachkalkulation" parent="sab_calculation_root_menu" action="action_sab_project_controlling" sequence="150"/>
</odoo>
