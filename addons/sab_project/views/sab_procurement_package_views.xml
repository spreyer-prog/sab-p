<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_procurement_package_wizard_form" model="ir.ui.view">
        <field name="name">sab.procurement.package.wizard.form</field>
        <field name="model">sab.procurement.package.wizard</field>
        <field name="arch" type="xml">
            <form string="Schaltschränke an Einkauf übergeben">
                <group col="4">
                    <field name="order_id"/>
                    <field name="project_id"/>
                </group>
                <group string="Welche Schaltschränke gehören in diese Materialanforderung?">
                    <field name="cabinet_bom_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <group>
                    <field name="note" placeholder="Hinweis an Einkauf oder Lager ..."/>
                </group>
                <div class="alert alert-info" role="alert">
                    Jede Stücklistenposition bleibt ihrem Verteiler zugeordnet. Gleiche Artikel
                    aus verschiedenen Schaltschränken werden nicht zusammengezogen, damit
                    Bestellung, Wareneingang und Kommissionierung eindeutig bleiben.
                </div>
                <footer>
                    <button name="action_create_procurement_package"
                            type="object"
                            string="Materialanforderung erzeugen"
                            class="btn-primary"/>
                    <button string="Abbrechen" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sab_procurement_package_wizard" model="ir.actions.act_window">
        <field name="name">Schaltschränke an Einkauf übergeben</field>
        <field name="res_model">sab.procurement.package.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_sab_procurement_extra_line_wizard_form" model="ir.ui.view">
        <field name="name">sab.procurement.extra.line.wizard.form</field>
        <field name="model">sab.procurement.extra.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Zusatzposition zur Beschaffung">
                <group col="4">
                    <field name="procurement_bom_id"/>
                    <field name="purchase_order_id" invisible="not purchase_order_id"/>
                    <field name="available_cabinet_bom_ids" invisible="1"/>
                    <field name="source_cabinet_bom_id"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="odoo_product_id"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="supplier_product_id"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="supplier_id"/>
                    <field name="quantity"/>
                    <field name="unit"/>
                    <field name="note" colspan="4"/>
                </group>
                <footer>
                    <button name="action_add_extra_line"
                            type="object"
                            string="Position hinzufügen"
                            class="btn-primary"/>
                    <button string="Abbrechen" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sab_procurement_extra_line_wizard" model="ir.actions.act_window">
        <field name="name">Zusatzposition zur Beschaffung</field>
        <field name="res_model">sab.procurement.extra.line.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_sale_order_form_procurement_package" model="ir.ui.view">
        <field name="name">sale.order.form.procurement.package</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">290</field>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_open_procurement_package_wizard"
                        type="object"
                        string="Schaltschränke an Einkauf übergeben"
                        class="btn-primary"
                        invisible="state not in ('sale','done') or sab_calculation_source != 'schematic'"
                        groups="project.group_project_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_sab_project_bom_form_procurement_package" model="ir.ui.view">
        <field name="name">sab.project.bom.form.procurement.package</field>
        <field name="model">sab.project.bom</field>
        <field name="inherit_id" ref="sab_project.view_sab_project_bom_form_procurement_workspace"/>
        <field name="priority">310</field>
        <field name="arch" type="xml">
            <button name="action_create_production_order" position="attributes">
                <attribute name="invisible">state != 'released' or bom_scope == 'procurement'</attribute>
            </button>
            <button name="action_release_for_purchase" position="attributes">
                <attribute name="invisible">state != 'released' or bom_scope not in ('total','procurement') or purchase_release_state == 'released'</attribute>
            </button>
            <button name="action_open_procurement_workspace" position="attributes">
                <attribute name="invisible">state != 'released' or bom_scope != 'procurement'</attribute>
            </button>
            <xpath expr="//form/header" position="inside">
                <button name="action_assign_picking"
                        type="object"
                        string="Kommissionierung zuweisen"
                        invisible="bom_scope != 'procurement' or state != 'released' or not picking_user_id"
                        groups="sab_project.group_sab_warehouse,sab_project.group_sab_purchasing,project.group_project_manager"/>
                <button name="action_print_picking_list"
                        type="object"
                        string="Kommissionierliste drucken"
                        invisible="bom_scope != 'procurement' or state != 'released'"
                        groups="sab_project.group_sab_warehouse,sab_project.group_sab_purchasing,project.group_project_manager"/>
                <button name="action_complete_picking"
                        type="object"
                        string="Reserviertes Material kommissionieren"
                        class="btn-primary"
                        invisible="bom_scope != 'procurement' or state != 'released' or not picking_user_id"
                        groups="sab_project.group_sab_warehouse,sab_project.group_sab_purchasing,project.group_project_manager"/>
                <button name="action_open_extra_line_wizard"
                        type="object"
                        string="Zusatzposition hinzufügen"
                        invisible="bom_scope != 'procurement' or state != 'released'"
                        groups="sab_project.group_sab_purchasing,project.group_project_manager"/>
            </xpath>
            <field name="scope_key" position="after">
                <field name="procurement_reference"
                       readonly="1"
                       invisible="bom_scope != 'procurement'"/>
                <field name="source_cabinet_bom_ids"
                       widget="many2many_tags"
                       readonly="1"
                       invisible="bom_scope != 'procurement'"/>
                <field name="source_cabinet_count"
                       readonly="1"
                       invisible="bom_scope != 'procurement'"/>
                <field name="procurement_acknowledged"
                       readonly="1"
                       invisible="bom_scope != 'procurement'"/>
                <field name="procurement_acknowledged_at"
                       readonly="1"
                       invisible="bom_scope != 'procurement' or not procurement_acknowledged_at"/>
                <field name="procurement_acknowledged_by_id"
                       readonly="1"
                       invisible="bom_scope != 'procurement' or not procurement_acknowledged_by_id"/>
                <field name="picking_user_id"
                       invisible="bom_scope != 'procurement'"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="picking_state"
                       readonly="1"
                       widget="badge"
                       invisible="bom_scope != 'procurement'"/>
                <field name="picking_assigned_at"
                       readonly="1"
                       invisible="bom_scope != 'procurement' or not picking_assigned_at"/>
                <field name="picking_assigned_by_id"
                       readonly="1"
                       invisible="bom_scope != 'procurement' or not picking_assigned_by_id"/>
                <field name="picking_completed_at"
                       readonly="1"
                       invisible="bom_scope != 'procurement' or not picking_completed_at"/>
                <field name="picking_completed_by_id"
                       readonly="1"
                       invisible="bom_scope != 'procurement' or not picking_completed_by_id"/>
            </field>
            <xpath expr="//page[@name='sab_bom_procurement_workspace']/parent::notebook" position="attributes">
                <attribute name="invisible">state != 'released' or bom_scope != 'procurement'</attribute>
            </xpath>
            <xpath expr="//page[@name='sab_bom_procurement_workspace']//field[@name='manufacturer_name']" position="before">
                <field name="source_cabinet_bom_id" string="Verteiler" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='sab_bom_procurement_workspace']//field[@name='project_reserved_quantity']" position="after">
                <field name="commissioned_quantity" string="Kommissioniert" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_sab_project_bom_list_procurement_package" model="ir.ui.view">
        <field name="name">sab.project.bom.list.procurement.package</field>
        <field name="model">sab.project.bom</field>
        <field name="inherit_id" ref="sab_project.view_sab_project_bom_list_switchboard"/>
        <field name="priority">310</field>
        <field name="arch" type="xml">
            <field name="bom_scope" position="after">
                <field name="procurement_reference" optional="show"/>
                <field name="source_cabinet_count" optional="show"/>
                <field name="picking_state" widget="badge" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_sab_procurement_dashboard_kanban_package" model="ir.ui.view">
        <field name="name">sab.project.bom.procurement.dashboard.kanban.package</field>
        <field name="model">sab.project.bom</field>
        <field name="inherit_id" ref="sab_project.view_sab_procurement_dashboard_kanban"/>
        <field name="priority">310</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="procurement_reference"/>
                <field name="source_cabinet_count"/>
                <field name="procurement_acknowledged"/>
                <field name="picking_state"/>
            </xpath>
            <xpath expr="//templates/t[@t-name='card']//field[@name='name']" position="after">
                <div class="small fw-semibold mt-1">
                    <field name="procurement_reference"/>
                    · <field name="source_cabinet_count"/> Schaltschränke
                </div>
                <span t-if="!record.procurement_acknowledged.raw_value"
                      class="badge text-bg-danger mt-2">Neu / noch nicht geöffnet</span>
                <div class="small text-muted mt-2">
                    Kommissionierung: <field name="picking_state"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_sab_procurement_dashboard_list_package" model="ir.ui.view">
        <field name="name">sab.project.bom.procurement.dashboard.list.package</field>
        <field name="model">sab.project.bom</field>
        <field name="inherit_id" ref="sab_project.view_sab_procurement_dashboard_list"/>
        <field name="priority">310</field>
        <field name="arch" type="xml">
            <field name="project_id" position="before">
                <field name="procurement_reference"/>
            </field>
            <field name="name" position="after">
                <field name="source_cabinet_count" string="Schaltschränke"/>
                <field name="procurement_acknowledged" string="Geöffnet" widget="boolean_toggle" readonly="1"/>
                <field name="picking_user_id" string="Kommissionierung" optional="show"/>
                <field name="picking_state" widget="badge" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_sab_procurement_dashboard_search_package" model="ir.ui.view">
        <field name="name">sab.project.bom.procurement.dashboard.search.package</field>
        <field name="model">sab.project.bom</field>
        <field name="inherit_id" ref="sab_project.view_sab_procurement_dashboard_search"/>
        <field name="priority">310</field>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="procurement_reference"/>
                <field name="source_cabinet_bom_ids"/>
                <field name="picking_user_id"/>
            </field>
            <filter name="new_for_purchasing" position="attributes">
                <attribute name="domain">[('procurement_acknowledged','=',False)]</attribute>
                <attribute name="string">Neu / noch nicht geöffnet</attribute>
            </filter>
            <filter name="purchase_released" position="after">
                <filter name="picking_open"
                        string="Kommissionierung offen"
                        domain="[('picking_state','in',('not_assigned','assigned','partial'))]"/>
            </filter>
        </field>
    </record>

    <record id="action_sab_procurement_dashboard" model="ir.actions.act_window">
        <field name="domain">[('state','=','released'),('bom_scope','=','procurement')]</field>
    </record>

    <record id="action_sab_procurement_new_boms" model="ir.actions.act_window">
        <field name="domain">[('state','=','released'),('bom_scope','=','procurement'),('procurement_acknowledged','=',False)]</field>
    </record>

    <record id="sab_stock_root_menu" model="ir.ui.menu">
        <field name="name">Einkauf / Lager</field>
        <field name="action" ref="action_sab_procurement_dashboard"/>
    </record>

    <record id="view_sab_purchase_requirement_list_package" model="ir.ui.view">
        <field name="name">sab.purchase.requirement.list.package</field>
        <field name="model">sab.purchase.requirement</field>
        <field name="inherit_id" ref="sab_project.view_sab_purchase_requirement_list_workspace"/>
        <field name="priority">310</field>
        <field name="arch" type="xml">
            <field name="manufacturer_name" position="before">
                <field name="source_cabinet_bom_id" string="Verteiler" optional="show"/>
            </field>
            <field name="project_reserved_quantity" position="after">
                <field name="commissioned_quantity" string="Kommissioniert" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_sab_purchase_requirement_form_package" model="ir.ui.view">
        <field name="name">sab.purchase.requirement.form.package</field>
        <field name="model">sab.purchase.requirement</field>
        <field name="inherit_id" ref="sab_project.view_sab_purchase_requirement_form_workspace"/>
        <field name="priority">310</field>
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="source_cabinet_bom_id" readonly="1"/>
            </field>
            <field name="project_reserved_quantity" position="after">
                <field name="commissioned_quantity" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_sab_purchase_order_form_package" model="ir.ui.view">
        <field name="name">sab.purchase.order.form.package</field>
        <field name="model">sab.purchase.order</field>
        <field name="inherit_id" ref="sab_project.view_sab_purchase_order_form_delivery_and_approval"/>
        <field name="priority">310</field>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_open_extra_line_wizard"
                        type="object"
                        string="Zusatzposition hinzufügen"
                        invisible="state != 'draft'"
                        groups="sab_project.group_sab_purchasing,project.group_project_manager"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='project_id']" position="after">
                <field name="procurement_bom_id" string="Materialanforderung" readonly="1" optional="hide"/>
                <field name="source_cabinet_bom_id" string="Verteiler" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="sab_project_project_form_procurement_package_domain" model="ir.ui.view">
        <field name="name">project.project.form.procurement.package.domain</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="sab_project.sab_project_project_form_procurement_detail"/>
        <field name="priority">310</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sab_total_material']/field[@name='sab_purchase_requirement_ids']" position="attributes">
                <attribute name="domain">[('bom_id.bom_scope','=','procurement'),('state','!=','cancel')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
