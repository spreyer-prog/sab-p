<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sab_sale_order_form_lv_rules" model="ir.ui.view">
        <field name="name">sale.order.form.sab.lv.rules</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sab_project.sab_sale_order_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sab_calculation']//field[@name='parent_section_id']" position="after">
                <field name="lv_position_locked" column_invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='sab_calculation']//field[@name='lv_position']" position="attributes">
                <attribute name="invisible">line_type in ('info', 'section_end')</attribute>
                <attribute name="readonly">lv_position_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='sab_calculation']//field[@name='is_ntg']" position="attributes">
                <attribute name="invisible">line_type in ('info', 'section_end')</attribute>
                <attribute name="readonly">lv_position_locked</attribute>
            </xpath>
            <xpath expr="//page[@name='sab_calculation']//field[@name='schematic_reference']" position="attributes">
                <attribute name="invisible">line_type in ('info', 'section_end')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
