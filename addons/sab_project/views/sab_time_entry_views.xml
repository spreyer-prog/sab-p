<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_time_entry_list" model="ir.ui.view">
        <field name="name">sab.time.entry.list</field>
        <field name="model">sab.time.entry</field>
        <field name="arch" type="xml">
            <list string="Zeitbuchungen">
                <field name="work_date"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <field name="activity_type"/>
                <field name="name"/>
                <field name="hours"/>
                <field name="hourly_cost" optional="show" groups="project.group_project_manager"/>
                <field name="cost_total" optional="show" groups="project.group_project_manager"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_sab_time_entry_form" model="ir.ui.view">
        <field name="name">sab.time.entry.form</field>
        <field name="model">sab.time.entry</field>
        <field name="arch" type="xml">
            <form string="SAB-P Zeitbuchung">
                <header>
                    <button name="action_confirm" type="object" string="Zeit buchen" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group col="4">
                        <field name="project_id" readonly="state == 'confirmed'"/>
                        <field name="user_id" readonly="state == 'confirmed'"/>
                        <field name="work_date" readonly="state == 'confirmed'"/>
                        <field name="activity_type" readonly="state == 'confirmed'"/>
                        <field name="name" colspan="4"/>
                        <field name="hours" readonly="state == 'confirmed'"/>
                        <field name="hourly_cost" readonly="state == 'confirmed'" groups="project.group_project_manager"/>
                        <field name="cost_total" readonly="1" groups="project.group_project_manager"/>
                    </group>
                    <group><field name="note"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sab_time_entry" model="ir.actions.act_window">
        <field name="name">Zeitbuchungen</field>
        <field name="res_model">sab.time.entry</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sab_time_entry_menu"
              name="Zeitbuchungen"
              parent="sab_calculation_root_menu"
              action="action_sab_time_entry"
              sequence="140"
              groups="project.group_project_manager"/>
</odoo>
