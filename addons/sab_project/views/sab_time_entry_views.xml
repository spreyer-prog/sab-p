<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_time_entry_list" model="ir.ui.view">
        <field name="name">sab.time.entry.list</field>
        <field name="model">sab.time.entry</field>
        <field name="arch" type="xml">
            <list string="Zeitbuchungen">
                <field name="work_date"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <field name="activity_type"/>
                <field name="name"/>
                <field name="hours"/>
                <field name="hourly_cost" optional="show"/>
                <field name="cost_total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sab_time_entry_form" model="ir.ui.view">
        <field name="name">sab.time.entry.form</field>
        <field name="model">sab.time.entry</field>
        <field name="arch" type="xml">
            <form string="SAB-P Zeitbuchung">
                <sheet>
                    <group col="4">
                        <field name="project_id"/>
                        <field name="user_id"/>
                        <field name="work_date"/>
                        <field name="activity_type"/>
                        <field name="name" colspan="4"/>
                        <field name="hours"/>
                        <field name="hourly_cost"/>
                        <field name="cost_total" readonly="1"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sab_time_entry" model="ir.actions.act_window">
        <field name="name">Zeitbuchungen</field>
        <field name="res_model">sab.time.entry</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sab_time_entry_menu" name="Zeitbuchungen" parent="sab_calculation_root_menu" action="action_sab_time_entry" sequence="140"/>
</odoo>
