<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Altansichten bleiben technisch für die Migration erhalten. -->
    <record id="view_sab_product_tree" model="ir.ui.view">
        <field name="name">sab.product.tree</field>
        <field name="model">sab.product</field>
        <field name="arch" type="xml">
            <list string="Produkte">
                <field name="manufacturer_id" string="Hersteller"/>
                <field name="manufacturer_supplier_id" string="Datenquelle / Lieferant" optional="hide"/>
                <field name="product_type"/>
                <field name="manufacturer_article_number"/>
                <field name="name"/>
                <field name="price_mode" string="Preisermittlung"/>
                <field name="calculated_purchase_price" string="Kalkulatorischer EK"/>
                <field name="datanorm_number" optional="hide"/>
                <field name="stock_on_hand" optional="show"/>
                <field name="stock_reserved" optional="show"/>
                <field name="stock_available" optional="show"/>
                <field name="space_units"/>
                <field name="mechanical_time_minutes"/>
                <field name="wiring_time_minutes"/>
                <field name="testing_time_minutes"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sab_product_form" model="ir.ui.view">
        <field name="name">sab.product.form</field>
        <field name="model">sab.product</field>
        <field name="arch" type="xml">
            <form string="Produkt">
                <sheet>
                    <group string="Identifikation" col="4">
                        <field name="manufacturer_id" string="Hersteller"/>
                        <field name="manufacturer_supplier_id" string="Datenquelle / Lieferant"/>
                        <field name="manufacturer_article_number"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sab_product" model="ir.actions.act_window">
        <field name="name">Produkte (Altbestand)</field>
        <field name="res_model">sab.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Neue Hauptansicht direkt auf dem normalen Odoo-Produktstamm. -->
    <record id="view_sab_odoo_product_tree" model="ir.ui.view">
        <field name="name">product.template.sab.p.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Produkte">
                <field name="sab_manufacturer_id" string="Hersteller"/>
                <field name="sab_manufacturer_supplier_id" string="Datenquelle / Lieferant" optional="hide"/>
                <field name="sab_product_type" string="Produkttyp"/>
                <field name="sab_manufacturer_article_number" string="Herstellerartikelnummer"/>
                <field name="name"/>
                <field name="sab_purchase_signal" string="Einkaufsampel" optional="show"/>
                <field name="sab_purchase_max_quantity" string="Höchstmenge" optional="hide"/>
                <field name="sab_price_mode" string="Preisermittlung"/>
                <field name="sab_calculated_purchase_price" string="Kalkulatorischer EK"/>
                <field name="sab_datanorm_number" string="DATANORM-Nummer" optional="hide"/>
                <field name="sab_stock_on_hand" string="Lagerbestand" optional="show"/>
                <field name="sab_stock_reserved" string="Reserviert" optional="show"/>
                <field name="sab_stock_available" string="Verfügbar" optional="show"/>
                <field name="sab_space_units" string="Platzeinheiten"/>
                <field name="sab_mechanical_time_minutes" string="Mechanikzeit in Minuten"/>
                <field name="sab_wiring_time_minutes" string="Verdrahtungszeit in Minuten"/>
                <field name="sab_testing_time_minutes" string="Prüfzeit in Minuten"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sab_odoo_product_form" model="ir.ui.view">
        <field name="name">product.template.sab.p.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Produkt">
                <sheet>
                    <group string="Identifikation" col="4">
                        <field name="sab_manufacturer_id" string="Hersteller" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="sab_manufacturer_supplier_id" string="Datenquelle / Lieferant" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="sab_manufacturer_article_number" string="Herstellerartikelnummer"/>
                        <field name="sab_product_type" string="Produkttyp"/>
                        <field name="active"/>
                        <field name="name" colspan="4"/>
                    </group>

                    <group string="Einkaufsfreigabe" col="4">
                        <field name="sab_purchase_signal" string="Einkaufsampel" widget="radio"/>
                        <field name="sab_purchase_max_quantity" string="Höchstmenge je Bestellposition" invisible="sab_purchase_signal != 'yellow'" required="sab_purchase_signal == 'yellow'"/>
                    </group>

                    <group string="Preisermittlung" col="4">
                        <field name="sab_price_mode" string="Preisermittlung"/>
                        <field name="sab_calculated_purchase_price" string="Kalkulatorischer EK" readonly="1"/>
                        <field name="sab_fixed_purchase_price" string="Fixpreis EK" invisible="sab_price_mode != 'fixed'"/>
                    </group>

                    <group string="Lager" col="4">
                        <field name="sab_stock_on_hand" string="Lagerbestand" readonly="1"/>
                        <field name="sab_stock_reserved" string="Reserviert" readonly="1"/>
                        <field name="sab_stock_available" string="Verfügbar" readonly="1"/>
                    </group>

                    <group string="Technische Kalkulationswerte" col="4">
                        <field name="sab_space_units" string="Platzeinheiten"/>
                        <field name="sab_mechanical_time_minutes" string="Mechanikzeit in Minuten"/>
                        <field name="sab_wiring_time_minutes" string="Verdrahtungszeit in Minuten"/>
                        <field name="sab_testing_time_minutes" string="Prüfzeit in Minuten"/>
                    </group>

                    <notebook>
                        <page string="Lieferantenartikel" invisible="sab_price_mode != 'supplier'">
                            <field name="sab_supplier_product_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="supplier_id"/>
                                    <field name="supplier_article_number"/>
                                    <field name="datanorm_number" optional="hide"/>
                                    <field name="list_price"/>
                                    <field name="purchase_price"/>
                                    <field name="discount_percent"/>
                                    <field name="net_purchase_price" readonly="1"/>
                                    <field name="preferred"/>
                                </list>
                            </field>
                        </page>

                        <page string="Baugruppe" invisible="sab_price_mode != 'assembly'">
                            <field name="sab_component_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="supplier_product_id" string="Lieferantenartikel"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" readonly="1"/>
                                    <field name="total_price" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="DATANORM">
                            <group col="4">
                                <field name="sab_manufacturer_id" string="Hersteller" readonly="1"/>
                                <field name="sab_datanorm_number" string="DATANORM-Nummer"/>
                            </group>
                        </page>

                        <page string="Lagerbewegungen">
                            <field name="sab_stock_movement_ids" nolabel="1" readonly="1">
                                <list default_order="movement_date desc">
                                    <field name="name"/>
                                    <field name="movement_date"/>
                                    <field name="movement_type"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="project_id" optional="show"/>
                                    <field name="user_id" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notizen">
                            <field name="sab_notes" placeholder="Interne Hinweise zum Produkt ..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Die Standard-Odoo-Produktmaske bekommt zusätzlich die SAB-P-Felder. -->
    <record id="view_product_template_form_sab_p" model="ir.ui.view">
        <field name="name">product.template.form.sab.p</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SAB-P" name="sab_p_calculation">
                    <group string="Identifikation" col="4">
                        <field name="sab_manufacturer_id" string="Hersteller"/>
                        <field name="sab_manufacturer_supplier_id" string="Datenquelle / Lieferant"/>
                        <field name="sab_manufacturer_article_number"/>
                        <field name="sab_product_type"/>
                        <field name="sab_datanorm_number"/>
                    </group>
                    <group string="Einkaufsfreigabe" col="4">
                        <field name="sab_purchase_signal" widget="radio"/>
                        <field name="sab_purchase_max_quantity" invisible="sab_purchase_signal != 'yellow'" required="sab_purchase_signal == 'yellow'"/>
                    </group>
                    <group string="Preisermittlung" col="4">
                        <field name="sab_price_mode"/>
                        <field name="sab_calculated_purchase_price" readonly="1"/>
                        <field name="sab_fixed_purchase_price" invisible="sab_price_mode != 'fixed'"/>
                    </group>
                    <group string="Technische Kalkulationswerte" col="4">
                        <field name="sab_space_units"/>
                        <field name="sab_mechanical_time_minutes"/>
                        <field name="sab_wiring_time_minutes"/>
                        <field name="sab_testing_time_minutes"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_sab_odoo_product" model="ir.actions.act_window">
        <field name="name">Produkte</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_sab_odoo_product_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_sab_odoo_product_form')})]"/>
    </record>

    <menuitem id="sab_product_menu" name="Produkte" parent="sab_calculation_root_menu" action="action_sab_odoo_product" sequence="30"/>
</odoo>
