<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- LISTENANSICHT                                         -->
    <!-- ===================================================== -->

    <record id="view_sab_product_tree" model="ir.ui.view">
        <field name="name">sab.product.tree</field>
        <field name="model">sab.product</field>
        <field name="arch" type="xml">

            <list string="Produkte">

                <field name="manufacturer_id"/>
                <field name="manufacturer_article_number"/>
                <field name="name"/>
                <field name="datanorm_number"/>

                <field name="space_units"/>
                <field name="mechanical_time_minutes"/>
                <field name="wiring_time_minutes"/>
                <field name="testing_time_minutes"/>

                <field name="active"/>

            </list>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- FORMULARANSICHT                                       -->
    <!-- ===================================================== -->

    <record id="view_sab_product_form" model="ir.ui.view">
        <field name="name">sab.product.form</field>
        <field name="model">sab.product</field>
        <field name="arch" type="xml">

            <form string="Produkt">

                <sheet>

                    <!-- STAMMDATEN -->

                    <group string="Stammdaten" col="4">

                        <field name="manufacturer_id"/>
                        
                        <field name="product_type"/>

                        <field name="manufacturer_article_number"/>

                        <field name="datanorm_number"/>

                        <field name="active"/>

                        <field
                            name="name"
                            colspan="4"
                        />

                    </group>


                    <!-- TECHNISCHE KALKULATIONSWERTE -->

                    <group string="Kalkulationswerte" col="4">

                        <field name="space_units"/>

                        <field name="mechanical_time_minutes"/>

                        <field name="wiring_time_minutes"/>

                        <field name="testing_time_minutes"/>

                    </group>


                    <!-- WEITERE INFORMATIONEN -->

                    <notebook>

                        <page string="Notizen">

                            <field
                                name="notes"
                                placeholder="Interne Hinweise zum Produkt ..."
                            />

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- AKTION                                                -->
    <!-- ===================================================== -->

    <record id="action_sab_product" model="ir.actions.act_window">

        <field name="name">Produkte</field>

        <field name="res_model">sab.product</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- ===================================================== -->
    <!-- MENÜ                                                  -->
    <!-- ===================================================== -->

    <menuitem
        id="sab_product_menu"
        name="Produkte"
        parent="sab_calculation_root_menu"
        action="action_sab_product"
        sequence="30"
    />

</odoo>