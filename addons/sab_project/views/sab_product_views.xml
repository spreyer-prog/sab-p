<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_product_tree" model="ir.ui.view">
        <field name="name">sab.product.tree</field>
        <field name="model">sab.product</field>
        <field name="arch" type="xml">
            <list string="Produkte">
                <field name="manufacturer_supplier_id" string="Hersteller"/>
                <field name="product_type"/>
                <field name="manufacturer_article_number"/>
                <field name="name"/>
                <field name="price_mode" string="Preisermittlung"/>
                <field name="calculated_purchase_price" string="Kalkulatorischer EK"/>
                <field name="datanorm_number" optional="hide"/>
                <field name="stock_on_hand" optional="show"/>
                <field name="stock_reserved" optional="show"/>
                <field name="stock_available" optional="show"/>
                <field name="space_units"/>
                <field name="mechanical_time_minutes"/>
                <field name="wiring_time_minutes"/>
                <field name="testing_time_minutes"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sab_product_form" model="ir.ui.view">
        <field name="name">sab.product.form</field>
        <field name="model">sab.product</field>
        <field name="arch" type="xml">
            <form string="Produkt">
                <sheet>
                    <group string="Identifikation" col="4">
                        <field name="manufacturer_supplier_id" string="Hersteller" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="manufacturer_article_number"/>
                        <field name="product_type"/>
                        <field name="active"/>
                        <field name="name" colspan="4"/>
                    </group>

                    <group string="Preisermittlung" col="4">
                        <field name="price_mode"/>
                        <field name="calculated_purchase_price" readonly="1"/>
                        <field name="fixed_purchase_price" string="Fixpreis EK" invisible="price_mode != 'fixed'"/>
                    </group>

                    <group string="Lager" col="4">
                        <field name="stock_on_hand" readonly="1"/>
                        <field name="stock_reserved" readonly="1"/>
                        <field name="stock_available" readonly="1"/>
                    </group>

                    <group string="Technische Kalkulationswerte" col="4">
                        <field name="space_units"/>
                        <field name="mechanical_time_minutes"/>
                        <field name="wiring_time_minutes"/>
                        <field name="testing_time_minutes"/>
                    </group>

                    <notebook>
                        <page string="Lieferantenartikel" invisible="price_mode != 'supplier'">
                            <field name="supplier_product_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="supplier_id"/>
                                    <field name="supplier_article_number"/>
                                    <field name="datanorm_number" optional="hide"/>
                                    <field name="list_price"/>
                                    <field name="purchase_price"/>
                                    <field name="discount_percent"/>
                                    <field name="net_purchase_price" readonly="1"/>
                                    <field name="preferred"/>
                                </list>
                            </field>
                        </page>

                        <page string="Baugruppe" invisible="price_mode != 'assembly'">
                            <field name="component_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="supplier_product_id" string="Lieferantenartikel"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" readonly="1"/>
                                    <field name="total_price" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="DATANORM">
                            <group><field name="datanorm_number"/></group>
                        </page>

                        <page string="Lagerbewegungen">
                            <field name="stock_movement_ids" nolabel="1" readonly="1">
                                <list default_order="movement_date desc">
                                    <field name="name"/>
                                    <field name="movement_date"/>
                                    <field name="movement_type"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="project_id" optional="show"/>
                                    <field name="user_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notizen"><field name="notes" placeholder="Interne Hinweise zum Produkt ..."/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sab_product" model="ir.actions.act_window">
        <field name="name">Produkte</field>
        <field name="res_model">sab.product</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="sab_product_menu" name="Produkte" parent="sab_calculation_root_menu" action="action_sab_product" sequence="30"/>
</odoo>
