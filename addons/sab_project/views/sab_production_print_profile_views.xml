<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_production_print_profile_list" model="ir.ui.view">
        <field name="name">sab.production.print.profile.list</field>
        <field name="model">sab.production.print.profile</field>
        <field name="arch" type="xml">
            <list string="Druckprofile" default_order="user_id,document_type">
                <field name="document_type"/>
                <field name="user_id" string="Benutzer (leer = Standard)"/>
                <field name="paper_kind"/>
                <field name="orientation"/>
                <field name="width_mm"/>
                <field name="height_mm"/>
                <field name="scale_percent"/>
                <field name="printer_name"/>
            </list>
        </field>
    </record>

    <record id="view_sab_production_print_profile_form" model="ir.ui.view">
        <field name="name">sab.production.print.profile.form</field>
        <field name="model">sab.production.print.profile</field>
        <field name="arch" type="xml">
            <form string="Druckprofil Fertigungsblatt">
                <sheet>
                    <group col="4">
                        <field name="document_type"/>
                        <field name="user_id"/>
                        <field name="paper_kind"/>
                        <field name="orientation"/>
                        <field name="printer_name" placeholder="z. B. Etikettendrucker Fertigung"/>
                        <field name="scale_percent"/>
                    </group>
                    <group string="Blattabmessungen und Ränder" col="4">
                        <field name="width_mm"/>
                        <field name="height_mm"/>
                        <field name="margin_top_mm"/>
                        <field name="margin_bottom_mm"/>
                        <field name="margin_left_mm"/>
                        <field name="margin_right_mm"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Persönliche Profile überschreiben für den angemeldeten Benutzer den Firmenstandard desselben Blatts. Der hinterlegte Druckername wird am Arbeitsplatz gespeichert; eine automatische physische Druckerübergabe setzt einen angebundenen Odoo-IoT-/Direct-Print-Dienst voraus.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sab_production_print_profiles" model="ir.actions.act_window">
        <field name="name">Druckprofile Fertigungsblätter</field>
        <field name="res_model">sab.production.print.profile</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_user_id': uid}</field>
    </record>

    <menuitem id="menu_sab_production_print_profiles"
              name="Druckprofile Fertigungsblätter"
              parent="sab_calculation_root_menu"
              action="action_sab_production_print_profiles"
              sequence="190"
              groups="base.group_user"/>
</odoo>
