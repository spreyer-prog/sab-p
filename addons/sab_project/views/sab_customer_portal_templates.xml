<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_sab_projects" name="SAB-P Kundenprojekte">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Meine SAB-P Projekte</t>
            </t>
            <div class="container py-3">
                <div t-if="not statuses" class="alert alert-info">
                    Aktuell sind keine Projekte für das Kundenportal freigegeben.
                </div>
                <div class="row g-3" t-else="">
                    <div class="col-12 col-lg-6" t-foreach="statuses" t-as="status">
                        <a t-att-href="'/my/sab-projects/%s' % status.id" class="text-decoration-none text-reset">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div>
                                            <div class="text-muted small" t-esc="status.project_id.sab_project_reference or ''"/>
                                            <h5 class="card-title mb-1" t-esc="status.project_id.name"/>
                                        </div>
                                        <span class="badge text-bg-primary" t-esc="dict(status._fields['milestone'].selection).get(status.milestone)"/>
                                    </div>
                                    <div class="mt-3">
                                        <div class="progress" role="progressbar" t-att-aria-valuenow="status.progress_percent" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar" t-att-style="'width: %s%%' % status.progress_percent">
                                                <t t-esc="status.progress_percent"/>%
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-3" t-if="status.project_id.sab_delivery_date">
                                        <strong>Liefertermin:</strong>
                                        <span t-field="status.project_id.sab_delivery_date"/>
                                    </div>
                                    <p class="mt-2 mb-0" t-if="status.note_customer" t-esc="status.note_customer"/>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_sab_project_detail" name="SAB-P Kundenprojekt Detail">
        <t t-call="portal.portal_layout">
            <div class="container py-3">
                <a href="/my/sab-projects" class="btn btn-link px-0 mb-2">← Zurück zu meinen Projekten</a>
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="text-muted" t-esc="project.sab_project_reference or ''"/>
                        <h2 class="mb-2" t-esc="project.name"/>
                        <div class="mb-2">
                            <strong>Status:</strong>
                            <span class="badge text-bg-primary" t-esc="dict(status._fields['milestone'].selection).get(status.milestone)"/>
                        </div>
                        <div class="progress mb-3" role="progressbar" t-att-aria-valuenow="status.progress_percent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" t-att-style="'width: %s%%' % status.progress_percent">
                                <t t-esc="status.progress_percent"/>%
                            </div>
                        </div>
                        <div t-if="project.sab_delivery_date"><strong>Liefertermin:</strong> <span t-field="project.sab_delivery_date"/></div>
                        <p class="mt-3 mb-0" t-if="status.note_customer" t-esc="status.note_customer"/>
                    </div>
                </div>

                <h4>Freigegebene Dokumente</h4>
                <div class="list-group mb-4" t-if="documents">
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                       t-foreach="documents" t-as="doc"
                       t-att-href="'/my/sab-document/%s/download' % doc.id">
                        <div>
                            <strong t-esc="doc.customer_title or doc.name"/>
                            <div class="small text-muted" t-if="doc.customer_note" t-esc="doc.customer_note"/>
                        </div>
                        <span>Download</span>
                    </a>
                </div>
                <div class="alert alert-light" t-else="">Keine Dokumente freigegeben.</div>

                <h4>Freigegebene Fotos</h4>
                <div class="row g-3" t-if="photos">
                    <div class="col-12 col-md-6 col-xl-4" t-foreach="photos" t-as="photo">
                        <div class="card h-100">
                            <img class="card-img-top" t-att-src="'/my/sab-photo/%s' % photo.id" alt="Projektfoto" loading="lazy"/>
                            <div class="card-body" t-if="photo.customer_caption">
                                <p class="card-text" t-esc="photo.customer_caption"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="alert alert-light" t-else="">Keine Fotos freigegeben.</div>
            </div>
        </t>
    </template>
</odoo>
