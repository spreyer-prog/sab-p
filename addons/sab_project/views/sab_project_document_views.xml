<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_project_document_list" model="ir.ui.view">
        <field name="name">sab.project.document.list</field>
        <field name="model">sab.project.document</field>
        <field name="arch" type="xml">
            <list string="Projektdokumente">
                <field name="project_id"/>
                <field name="document_type"/>
                <field name="name"/>
                <field name="version"/>
                <field name="file_name"/>
                <field name="state"/>
                <field name="customer_visible" optional="show"/>
                <field name="released_at" optional="hide"/>
                <field name="released_by_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sab_project_document_form" model="ir.ui.view">
        <field name="name">sab.project.document.form</field>
        <field name="model">sab.project.document</field>
        <field name="arch" type="xml">
            <form string="SAB-P Projektdokument">
                <header>
                    <button name="action_release" type="object" string="Dokument intern freigeben" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_release_to_customer" type="object" string="Für Kundenportal freigeben" class="btn-secondary" invisible="state != 'released' or customer_visible" groups="project.group_project_manager"/>
                    <button name="action_withdraw_customer_release" type="object" string="Kundenfreigabe zurückziehen" invisible="not customer_visible" groups="project.group_project_manager"/>
                    <button name="action_create_revision" type="object" string="Neue Revision" invisible="state != 'released'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,released,obsolete"/>
                </header>
                <sheet>
                    <group col="4">
                        <field name="project_id" readonly="state != 'draft'"/>
                        <field name="document_type" readonly="state != 'draft'"/>
                        <field name="name" readonly="state == 'obsolete'"/>
                        <field name="version" readonly="1"/>
                        <field name="file_name" readonly="state != 'draft'"/>
                        <field name="file_data" filename="file_name" readonly="state != 'draft'"/>
                        <field name="revision_of_id" readonly="1"/>
                        <field name="released_at" readonly="1"/>
                        <field name="released_by_id" readonly="1"/>
                    </group>
                    <group string="Kundenportal">
                        <field name="customer_visible" readonly="1"/>
                        <field name="customer_title"/>
                        <field name="customer_note"/>
                        <field name="customer_released_at" readonly="1" invisible="not customer_visible"/>
                        <field name="customer_released_by_id" readonly="1" invisible="not customer_visible"/>
                    </group>
                    <group string="Intern">
                        <field name="note"/>
                    </group>
                    <notebook invisible="not revision_ids">
                        <page string="Revisionen">
                            <field name="revision_ids" readonly="1">
                                <list>
                                    <field name="version"/>
                                    <field name="name"/>
                                    <field name="file_name"/>
                                    <field name="state"/>
                                    <field name="customer_visible"/>
                                    <field name="released_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sab_project_document" model="ir.actions.act_window">
        <field name="name">Projektdokumente</field>
        <field name="res_model">sab.project.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sab_project_document_menu" name="Dokumente" parent="sab_calculation_root_menu" action="action_sab_project_document" sequence="130"/>
</odoo>
