<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sab_sale_order_form_unit_rounding" model="ir.ui.view">
        <field name="name">sale.order.form.sab.unit.rounding</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sab_project.sab_sale_order_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sab_calculation_source']" position="after">
                <field name="sab_price_rounding_version" readonly="1" invisible="not sab_project_id"/>
            </xpath>
        </field>
    </record>
</odoo>
