<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_project_bom_list" model="ir.ui.view">
        <field name="name">sab.project.bom.list</field>
        <field name="model">sab.project.bom</field>
        <field name="arch" type="xml">
            <list string="SAB-P Stücklisten">
                <field name="name"/>
                <field name="project_id"/>
                <field name="order_id"/>
                <field name="state"/>
                <field name="generated_at"/>
                <field name="generated_by_id"/>
                <field name="production_order_count"/>
            </list>
        </field>
    </record>

    <record id="view_sab_project_bom_form" model="ir.ui.view">
        <field name="name">sab.project.bom.form</field>
        <field name="model">sab.project.bom</field>
        <field name="arch" type="xml">
            <form string="SAB-P Stückliste">
                <header>
                    <button name="action_release"
                            type="object"
                            string="Stückliste freigeben"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_production_order"
                            type="object"
                            string="Fertigungsauftrag erzeugen"
                            class="btn-primary"
                            invisible="state != 'released'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,released"/>
                </header>
                <sheet>
                    <group col="4">
                        <field name="name"/>
                        <field name="project_id" readonly="1"/>
                        <field name="order_id" readonly="1"/>
                        <field name="generated_at" readonly="1"/>
                        <field name="generated_by_id" readonly="1"/>
                        <field name="production_order_count" readonly="1"/>
                    </group>

                    <field name="line_ids" nolabel="1" readonly="state == 'released'">
                        <list editable="bottom" default_order="sequence">
                            <field name="sequence" widget="handle" string="Pos."/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="unit"/>
                            <field name="optional"/>
                            <field name="supplier_product_id" optional="show"/>
                            <field name="unit_purchase_price" readonly="1" optional="show"/>
                            <field name="purchase_total" readonly="1" optional="show"/>
                            <field name="note" optional="show"/>
                        </list>
                    </field>

                    <group>
                        <field name="note" readonly="state == 'released'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sab_project_bom" model="ir.actions.act_window">
        <field name="name">Stücklisten</field>
        <field name="res_model">sab.project.bom</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sab_project_bom_menu"
              name="Stücklisten"
              parent="sab_calculation_root_menu"
              action="action_sab_project_bom"
              sequence="90"/>
</odoo>
