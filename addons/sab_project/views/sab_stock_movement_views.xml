<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_stock_movement_list" model="ir.ui.view">
        <field name="name">sab.stock.movement.list</field>
        <field name="model">sab.stock.movement</field>
        <field name="arch" type="xml">
            <list string="Lagerbewegungen" create="1" delete="0">
                <field name="name"/>
                <field name="movement_date"/>
                <field name="product_id"/>
                <field name="movement_type"/>
                <field name="quantity"/>
                <field name="unit"/>
                <field name="project_id" optional="show"/>
                <field name="purchase_requirement_id" optional="show"/>
                <field name="user_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sab_stock_movement_form" model="ir.ui.view">
        <field name="name">sab.stock.movement.form</field>
        <field name="model">sab.stock.movement</field>
        <field name="arch" type="xml">
            <form string="SAB-P Lagerbewegung" delete="0">
                <sheet>
                    <group col="4">
                        <field name="name" readonly="1"/>
                        <field name="movement_date" readonly="1"/>
                        <field name="product_id" readonly="id"/>
                        <field name="movement_type" readonly="id"/>
                        <field name="quantity" readonly="id"/>
                        <field name="unit" readonly="id"/>
                        <field name="project_id"/>
                        <field name="purchase_requirement_id" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sab_stock_movement" model="ir.actions.act_window">
        <field name="name">Lagerbewegungen</field>
        <field name="res_model">sab.stock.movement</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sab_stock_movement_menu" name="Lagerbewegungen" parent="sab_calculation_root_menu" action="action_sab_stock_movement" sequence="120"/>
</odoo>
