<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_calculation_change_log_list" model="ir.ui.view">
        <field name="name">sab.calculation.change.log.list</field>
        <field name="model">sab.calculation.change.log</field>
        <field name="arch" type="xml">
            <list string="Änderungsprotokoll Kalkulation" create="0" edit="0" delete="0">
                <field name="changed_at"/>
                <field name="changed_by_id"/>
                <field name="parameter_label"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sab_calculation_change_log_form" model="ir.ui.view">
        <field name="name">sab.calculation.change.log.form</field>
        <field name="model">sab.calculation.change.log</field>
        <field name="arch" type="xml">
            <form string="Änderungsprotokoll Kalkulation" create="0" edit="0" delete="0">
                <sheet>
                    <group col="4">
                        <field name="changed_at"/>
                        <field name="changed_by_id"/>
                        <field name="parameter_key"/>
                        <field name="parameter_label"/>
                        <field name="old_value"/>
                        <field name="new_value"/>
                        <field name="note" colspan="4"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sab_calculation_change_log" model="ir.actions.act_window">
        <field name="name">Änderungsprotokoll Kalkulation</field>
        <field name="res_model">sab.calculation.change.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sab_calculation_change_log_menu"
              name="Änderungsprotokoll"
              parent="sab_calculation_root_menu"
              action="action_sab_calculation_change_log"
              sequence="80"/>
</odoo>
