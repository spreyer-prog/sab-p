<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_overdue_delivery_line_list" model="ir.ui.view">
        <field name="name">sab.purchase.order.line.overdue.delivery.list</field>
        <field name="model">sab.purchase.order.line</field>
        <field name="arch" type="xml">
            <list string="Überfällige Liefertermine"
                  create="0"
                  delete="0"
                  decoration-danger="delivery_is_overdue">
                <header>
                    <button name="action_send_overdue_delivery_reminder"
                            type="object"
                            string="Nachfrage je Bestellung zusammengefasst senden"
                            class="btn-primary"
                            groups="sab_project.group_sab_purchasing"/>
                </header>
                <field name="order_id" string="Bestellung"/>
                <field name="supplier_id" string="Lieferant"/>
                <field name="procurement_bom_id" string="Materialanforderung" optional="show"/>
                <field name="source_cabinet_bom_id" string="Verteiler" optional="show"/>
                <field name="project_id" string="Projekt" optional="show"/>
                <field name="supplier_article_number" string="Artikelnummer"/>
                <field name="odoo_product_id" string="Produkt"/>
                <field name="quantity_ordered" string="Bestellt"/>
                <field name="quantity_received" string="Geliefert"/>
                <field name="quantity_remaining" string="Offen"/>
                <field name="expected_delivery_date" string="Bestätigter Liefertermin"/>
                <field name="delivery_overdue_days" string="Überfällig (Tage)"/>
                <field name="delivery_status" widget="badge"/>
                <field name="delivery_reminder_count" string="Nachfragen"/>
                <field name="delivery_reminder_sent_at" string="Letzte Nachfrage" optional="show"/>
                <button name="action_send_overdue_delivery_reminder"
                        type="object"
                        string="Nachfrage senden"
                        class="btn-link"
                        groups="sab_project.group_sab_purchasing"/>
            </list>
        </field>
    </record>

    <record id="view_sab_overdue_delivery_line_form" model="ir.ui.view">
        <field name="name">sab.purchase.order.line.overdue.delivery.form</field>
        <field name="model">sab.purchase.order.line</field>
        <field name="arch" type="xml">
            <form string="Überfällige Lieferposition" create="0" delete="0">
                <header>
                    <button name="action_send_overdue_delivery_reminder"
                            type="object"
                            string="Nachfrage an Lieferanten senden"
                            class="btn-primary"
                            invisible="not delivery_is_overdue"
                            groups="sab_project.group_sab_purchasing"/>
                    <field name="delivery_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group col="4">
                        <field name="order_id" readonly="1"/>
                        <field name="supplier_id" readonly="1"/>
                        <field name="procurement_bom_id" readonly="1"/>
                        <field name="source_cabinet_bom_id" readonly="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="supplier_article_number" readonly="1"/>
                        <field name="odoo_product_id" readonly="1"/>
                        <field name="quantity_ordered" readonly="1"/>
                        <field name="quantity_received" readonly="1"/>
                        <field name="quantity_remaining" readonly="1"/>
                        <field name="expected_delivery_date" readonly="1"/>
                        <field name="delivery_is_overdue" readonly="1"/>
                        <field name="delivery_overdue_days" readonly="1"/>
                        <field name="delivery_reminder_count" readonly="1"/>
                        <field name="delivery_reminder_sent_at" readonly="1"/>
                        <field name="delivery_reminder_sent_by_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sab_overdue_delivery_line_search" model="ir.ui.view">
        <field name="name">sab.purchase.order.line.overdue.delivery.search</field>
        <field name="model">sab.purchase.order.line</field>
        <field name="arch" type="xml">
            <search string="Überfällige Liefertermine">
                <field name="order_id"/>
                <field name="supplier_id"/>
                <field name="project_id"/>
                <field name="source_cabinet_bom_id"/>
                <field name="supplier_article_number"/>
                <field name="odoo_product_id"/>
                <separator/>
                <filter name="overdue" string="Überfällig"
                        domain="[('delivery_is_overdue','=',True)]"/>
                <filter name="not_reminded" string="Noch keine Nachfrage"
                        domain="[('delivery_reminder_count','=',0)]"/>
                <filter name="reminded" string="Nachfrage bereits versendet"
                        domain="[('delivery_reminder_count','>',0)]"/>
                <group>
                    <filter name="group_order" string="Bestellung"
                            context="{'group_by':'order_id'}"/>
                    <filter name="group_supplier" string="Lieferant"
                            context="{'group_by':'supplier_id'}"/>
                    <filter name="group_project" string="Projekt"
                            context="{'group_by':'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sab_overdue_delivery_lines" model="ir.actions.act_window">
        <field name="name">Überfällige Liefertermine</field>
        <field name="res_model">sab.purchase.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sab_overdue_delivery_line_search"/>
        <field name="domain">[('delivery_is_overdue','=',True)]</field>
        <field name="context">{'search_default_overdue': 1, 'search_default_group_order': 1}</field>
        <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_sab_overdue_delivery_line_list')}),(0,0,{'view_mode':'form','view_id':ref('view_sab_overdue_delivery_line_form')})]"/>
    </record>

    <menuitem id="sab_overdue_delivery_menu"
              name="Überfällige Liefertermine"
              parent="sab_stock_root_menu"
              action="action_sab_overdue_delivery_lines"
              sequence="35"
              groups="sab_project.group_sab_purchasing,sab_project.group_sab_purchase_approver,project.group_project_manager"/>

    <record id="view_sab_purchase_order_list_overdue_delivery" model="ir.ui.view">
        <field name="name">sab.purchase.order.list.overdue.delivery</field>
        <field name="model">sab.purchase.order</field>
        <field name="inherit_id" ref="sab_project.view_sab_purchase_order_list_delivery"/>
        <field name="priority">320</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">has_overdue_delivery</attribute>
            </xpath>
            <field name="next_delivery_date" position="after">
                <field name="has_overdue_delivery" string="Überfällig" optional="show"/>
                <field name="overdue_line_count" string="Überfällige Positionen" optional="show"/>
                <field name="maximum_delivery_overdue_days" string="Max. überfällig (Tage)" optional="show"/>
                <field name="delivery_reminder_sent_at" string="Letzte Nachfrage" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_sab_purchase_order_form_overdue_delivery" model="ir.ui.view">
        <field name="name">sab.purchase.order.form.overdue.delivery</field>
        <field name="model">sab.purchase.order</field>
        <field name="inherit_id" ref="sab_project.view_sab_purchase_order_form_delivery_and_approval"/>
        <field name="priority">320</field>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_send_overdue_delivery_reminder"
                        type="object"
                        string="Liefertermin nachfragen"
                        class="btn-primary"
                        invisible="not has_overdue_delivery"
                        groups="sab_project.group_sab_purchasing"/>
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_overdue_delivery_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-exclamation-triangle"
                            invisible="overdue_line_count == 0">
                        <field name="overdue_line_count"
                               string="Überfällige Positionen"
                               widget="statinfo"/>
                    </button>
                </div>
            </xpath>
            <field name="next_delivery_date" position="after">
                <field name="has_overdue_delivery" readonly="1" invisible="1"/>
                <field name="maximum_delivery_overdue_days"
                       readonly="1"
                       invisible="not has_overdue_delivery"/>
                <field name="delivery_reminder_sent_at"
                       readonly="1"
                       invisible="not delivery_reminder_sent_at"/>
                <field name="delivery_reminder_sent_by_id"
                       readonly="1"
                       invisible="not delivery_reminder_sent_by_id"/>
            </field>
            <xpath expr="//field[@name='line_ids']/list/field[@name='expected_delivery_date']" position="after">
                <field name="delivery_status" widget="badge" readonly="1" optional="show"/>
                <field name="delivery_overdue_days" string="Überfällig (Tage)" readonly="1" optional="show"/>
                <field name="delivery_reminder_count" string="Nachfragen" readonly="1" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
