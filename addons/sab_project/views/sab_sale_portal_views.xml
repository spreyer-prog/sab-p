<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sab_sale_order_portal_calculation" inherit_id="sale.sale_order_portal_content" priority="50">
        <!-- Odoo 19: die Standard-Angebotspositionen liegen im Container name="sol_table".
             Bei SAB-P Angeboten bleibt ausschließlich die SAB-P Kalkulation kundenführend. -->
        <xpath expr="//div[@name='sol_table']" position="attributes">
            <attribute name="t-if">not sale_order.sab_calculation_line_ids</attribute>
        </xpath>

        <xpath expr="//div[@name='sol_table']" position="after">
            <div t-if="sale_order.sab_calculation_line_ids" class="table-responsive" name="sab_calculation_portal_table">
                <table class="table table-sm align-middle" id="sab_sales_order_table">
                    <thead>
                        <tr>
                            <th class="text-start" style="width:12%;">LV / Pos.</th>
                            <th class="text-start">Beschreibung</th>
                            <th class="text-end" style="width:10%;">Menge</th>
                            <th class="text-end" style="width:15%;">Einzelpreis</th>
                            <th class="text-end" style="width:15%;">Gesamtpreis</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="sale_order.sab_calculation_line_ids.sorted(key=lambda l: (l.sequence, l.id))" t-as="line">
                            <t t-if="line.line_type == 'cabinet'">
                                <tr class="sab-structure-spacer" aria-hidden="true">
                                    <td colspan="5" style="height: 6px; padding: 0; border: 0; background: transparent;"></td>
                                </tr>
                                <tr class="fw-bold border-top border-bottom">
                                    <td></td>
                                    <td class="text-center"><span t-out="line.description"/></td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-end text-nowrap"><span t-out="line.cabinet_total" t-options="{'widget':'monetary','display_currency':sale_order.currency_id}"/></td>
                                </tr>
                            </t>
                            <t t-elif="line.line_type == 'section'">
                                <tr class="sab-structure-spacer" aria-hidden="true">
                                    <td colspan="5" style="height: 4px; padding: 0; border: 0; background: transparent;"></td>
                                </tr>
                                <tr class="fw-bold border-top bg-light">
                                    <td><span t-out="line.lv_position or line.schematic_reference or ''"/></td>
                                    <td t-att-style="'padding-left: 1rem;' if line.parent_cabinet_id else ''"><span t-out="line.description"/></td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-end text-nowrap"><span t-out="line.section_total" t-options="{'widget':'monetary','display_currency':sale_order.currency_id}"/></td>
                                </tr>
                            </t>
                            <t t-elif="line.line_type == 'info'">
                                <tr class="fst-italic">
                                    <td></td>
                                    <td colspan="4"><span t-out="line.description"/></td>
                                </tr>
                            </t>
                            <t t-elif="line.line_type == 'item' and not line.parent_section_id">
                                <tr>
                                    <td><span t-out="line.lv_position or line.schematic_reference or ''"/></td>
                                    <td t-att-style="'padding-left: 1rem;' if line.parent_cabinet_id else ''">
                                        <span t-out="line.description or (line.calculation_item_id and (line.calculation_item_id.quotation_text or line.calculation_item_id.name)) or (line.odoo_product_id and line.odoo_product_id.display_name) or ''"/>
                                    </td>
                                    <td class="text-end"><span t-out="line.quantity" t-options="{'widget':'float','precision':2}"/></td>
                                    <td class="text-end text-nowrap"><span t-out="line.unit_recommended_net_price" t-options="{'widget':'monetary','display_currency':sale_order.currency_id}"/></td>
                                    <td class="text-end text-nowrap"><span t-out="line.recommended_net_price" t-options="{'widget':'monetary','display_currency':sale_order.currency_id}"/></td>
                                </tr>
                            </t>
                            <!-- Positionen innerhalb eines Bauteils bleiben intern und werden dem Kunden nicht einzeln angezeigt. -->
                            <t t-elif="line.line_type in ('section_end', 'cabinet_end')">
                                <tr class="sab-structure-spacer" aria-hidden="true">
                                    <td colspan="5" t-att-style="'height: 6px; padding: 0; border: 0; background: transparent;' if line.line_type == 'cabinet_end' else 'height: 4px; padding: 0; border: 0; background: transparent;'"></td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
