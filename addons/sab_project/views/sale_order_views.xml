<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sab_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.sab.project</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_sab_revision" type="object" string="Neue Revision" class="btn-secondary" invisible="not sab_project_id"/>
                <button name="action_generate_sab_bom" type="object" string="Stückliste erzeugen" class="btn-primary" invisible="not sab_project_id or state not in ('sale', 'done')"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sab_project_id" required="state in ('draft', 'sent')" readonly="state not in ('draft', 'sent')"/>
                <field name="sab_offer_reference" readonly="1" invisible="not sab_offer_reference"/>
                <field name="sab_revision_of_id" readonly="1" invisible="not sab_revision_of_id"/>
                <field name="sab_revision_reason" invisible="not sab_revision_of_id"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="SAB-P Kalkulation" name="sab_calculation">
                    <group string="Bauteile / Gruppenpreise" col="1">
                        <field name="sab_calculation_group_ids" nolabel="1" readonly="state not in ('draft', 'sent')">
                            <list editable="bottom" default_order="sequence">
                                <field name="sequence" widget="handle" string="Pos."/>
                                <field name="name" string="Bauteil"/>
                                <field name="description" string="Angebotstext" optional="show"/>
                                <field name="group_net_price" string="Gruppenpreis / VK netto" readonly="1"/>
                                <field name="note" optional="show"/>
                            </list>
                        </field>
                    </group>

                    <group string="Kalkulationspositionen" col="1">
                        <field name="sab_calculation_line_ids" nolabel="1" readonly="state not in ('draft', 'sent')">
                            <list editable="bottom" default_order="sequence">
                                <field name="order_id" column_invisible="1"/>
                                <field name="sequence" widget="handle" string="Pos."/>
                                <field name="group_id" string="Bauteil" optional="show" options="{'no_create_edit': True}"/>
                                <field name="calculation_item_id" string="Kalkulationsartikel"/>
                                <field name="quantity" string="Menge"/>
                                <field name="description" string="Angebotstext" optional="show"/>
                                <field name="unit_recommended_net_price" string="VK je Einheit" readonly="1"/>
                                <field name="recommended_net_price" string="VK gesamt" readonly="1"/>
                                <field name="note" string="Bemerkung" optional="show"/>

                                <!-- Interne Kalkulationswerte bleiben verfügbar, sind aber standardmäßig ausgeblendet. -->
                                <field name="material_purchase_total" string="Material-EK" readonly="1" optional="hide"/>
                                <field name="mechanical_time_minutes" string="Mechanik min" readonly="1" optional="hide"/>
                                <field name="wiring_time_minutes" string="Verdrahtung min" readonly="1" optional="hide"/>
                                <field name="testing_time_minutes" string="Prüfung min" readonly="1" optional="hide"/>
                                <field name="total_hours" string="Gesamtstunden" readonly="1" optional="hide"/>
                                <field name="space_units" string="Platzeinheiten" readonly="1" optional="hide"/>
                            </list>
                        </field>
                    </group>

                    <group string="Angebotssumme" col="4">
                        <field name="sab_offer_net_total" string="Netto-Angebotssumme" readonly="1"/>
                        <field name="sab_material_purchase_total" string="Material-EK gesamt" readonly="1" optional="hide"/>
                        <field name="sab_calculated_hours" string="Kalkulierte Zeit" readonly="1" optional="hide"/>
                        <field name="sab_space_units" string="Platzeinheiten" readonly="1" optional="hide"/>
                    </group>

                    <div class="alert alert-info" role="alert">
                        Mehrere Kalkulationspositionen können einem Bauteil zugeordnet werden. Im Angebotsdruck werden die internen Einzelpositionen dieses Bauteils nicht gezeigt; sichtbar ist nur das Bauteil mit seinem Gruppenpreis.
                        Die sichtbaren Verkaufspreise werden aus den Kalkulationswerten und den im Reiter „Kalkulationsfaktoren“ gespeicherten Angebotsfaktoren berechnet.
                    </div>
                </page>

                <page string="Kalkulationsfaktoren" name="sab_calculation_factors">
                    <group string="Material und Zeit" col="4">
                        <field name="sab_material_factor" readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_aux_material_factor" readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_hourly_rate" readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_time_factor" readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_difficulty_factor" readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_planning_surcharge_factor" string="Planungszuschlag – Formelabgleich offen" readonly="state not in ('draft', 'sent')"/>
                    </group>

                    <group string="Kaufmännische Faktoren" col="4">
                        <field name="sab_packaging_factor" readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_skonto_factor" readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_margin_factor" readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_rebate_factor" readonly="state not in ('draft', 'sent')"/>
                    </group>

                    <group string="Kontrollwerte" col="5">
                        <field name="sab_material_cost" readonly="1"/>
                        <field name="sab_labor_cost" readonly="1"/>
                        <field name="sab_direct_cost" readonly="1"/>
                        <field name="sab_commercial_factor" readonly="1"/>
                        <field name="sab_recommended_net_price" readonly="1"/>
                    </group>

                    <div class="alert alert-secondary" role="alert">
                        Diese Faktoren gelten nur für dieses Angebot und werden mit dem Angebot gespeichert. Änderungen wirken direkt auf die kalkulierten Verkaufspreise der SAB-P Kalkulationspositionen und Bauteile.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
