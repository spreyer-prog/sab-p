<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sab_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.sab.project</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_create_sab_revision"
                        type="object"
                        string="Neue Revision"
                        class="btn-secondary"
                        invisible="not sab_project_id"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sab_project_id"
                       required="state in ('draft', 'sent')"
                       readonly="state not in ('draft', 'sent')"/>
                <field name="sab_offer_reference"
                       readonly="1"
                       invisible="not sab_offer_reference"/>
                <field name="sab_revision_of_id"
                       readonly="1"
                       invisible="not sab_revision_of_id"/>
                <field name="sab_revision_reason"
                       invisible="not sab_revision_of_id"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="SAB-P Kalkulation" name="sab_calculation">
                    <field name="sab_calculation_line_ids" nolabel="1"
                           readonly="state not in ('draft', 'sent')">
                        <list editable="bottom" default_order="sequence">
                            <field name="sequence" widget="handle" string="Pos."/>
                            <field name="calculation_item_id"/>
                            <field name="quantity"/>
                            <field name="description" optional="show"/>
                            <field name="material_purchase_total" readonly="1"/>
                            <field name="mechanical_time_minutes" readonly="1" optional="show"/>
                            <field name="wiring_time_minutes" readonly="1" optional="show"/>
                            <field name="testing_time_minutes" readonly="1" optional="show"/>
                            <field name="total_hours" readonly="1"/>
                            <field name="space_units" readonly="1" optional="show"/>
                            <field name="note" optional="show"/>
                        </list>
                    </field>

                    <group string="Technische und kaufmännische Summen" col="6">
                        <field name="sab_material_purchase_total" readonly="1"/>
                        <field name="sab_mechanical_hours" readonly="1"/>
                        <field name="sab_wiring_hours" readonly="1"/>
                        <field name="sab_testing_hours" readonly="1"/>
                        <field name="sab_calculated_hours" readonly="1"/>
                        <field name="sab_space_units" readonly="1"/>
                    </group>

                    <group string="Kalkulationsfaktoren" col="5">
                        <field name="sab_material_factor"
                               readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_aux_material_factor"
                               readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_hourly_rate"
                               readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_time_factor"
                               readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_difficulty_factor"
                               readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_planning_surcharge_factor"
                               readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_packaging_factor"
                               readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_skonto_factor"
                               readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_margin_factor"
                               readonly="state not in ('draft', 'sent')"/>
                        <field name="sab_rebate_factor"
                               readonly="state not in ('draft', 'sent')"/>
                    </group>

                    <group string="Kalkulatorischer Richtwert" col="5">
                        <field name="sab_material_cost" readonly="1"/>
                        <field name="sab_labor_cost" readonly="1"/>
                        <field name="sab_direct_cost" readonly="1"/>
                        <field name="sab_commercial_factor" readonly="1"/>
                        <field name="sab_recommended_net_price" readonly="1"/>
                    </group>

                    <div class="alert alert-info" role="alert">
                        Der kalkulatorische Netto-Richtwert dient dem Vergleich mit der SAB-P Kalkulation.
                        Er überschreibt die Verkaufspreise der Odoo-Angebotspositionen nicht automatisch.
                    </div>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
