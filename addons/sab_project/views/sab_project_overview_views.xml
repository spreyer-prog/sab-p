<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sab_project_overview_list" model="ir.ui.view">
        <field name="name">project.project.list.sab.overview</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="SAB-P Projektübersicht"
                  decoration-success="sab_status == 'won'"
                  decoration-danger="sab_status == 'lost'"
                  decoration-info="sab_status == 'customer_awarded'"
                  default_order="sab_project_reference desc">
                <field name="sab_project_reference" string="Projekt-Nr."/>
                <field name="sab_request_date" string="Datum"/>
                <field name="sab_status"
                       string="Status"
                       widget="badge"
                       decoration-success="sab_status == 'won'"
                       decoration-danger="sab_status == 'lost'"
                       decoration-info="sab_status == 'customer_awarded'"/>
                <field name="name" string="Projekt"/>
                <field name="sab_commission" string="Kommission" optional="show"/>
                <field name="sab_offer_identifier" string="Angebotskennzeichen" optional="hide"/>
                <field name="sab_customer_order_reference" string="Bestell-Nr." optional="hide"/>
                <field name="partner_id" string="Kunde"/>
                <field name="user_id" string="Bearbeiter"/>
                <field name="sab_follow_up_date" string="Wiedervorlage" optional="hide"/>
                <field name="sab_offer_amount" string="Gesamtangebot" sum="Gesamt"/>
                <field name="sab_inquiry_type_id" string="Art der Anfrage"/>
                <field name="sab_technology_id" string="Technik"/>
                <field name="sab_service_type_id" string="Leistungsart"/>
            </list>
        </field>
    </record>

    <record id="sab_project_overview_action" model="ir.actions.act_window">
        <field name="name">SAB-P Projektübersicht</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(ref('sab_project_overview_list'), 'list'), (False, 'form')]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Neues SAB-P Projekt anlegen
            </p>
        </field>
    </record>

    <menuitem id="sab_project_overview_menu"
              name="Projektübersicht"
              parent="sab_project_projects_menu"
              action="sab_project_overview_action"
              sequence="10"/>
</odoo>
