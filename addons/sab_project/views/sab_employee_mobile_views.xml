<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_employee_step_kanban" model="ir.ui.view">
        <field name="name">sab.production.step.employee.kanban</field>
        <field name="model">sab.production.step</field>
        <field name="arch" type="xml">
            <kanban string="Meine Arbeit" default_group_by="state" class="o_kanban_mobile">
                <field name="production_order_id"/>
                <field name="project_id"/>
                <field name="delivery_date"/>
                <field name="name"/>
                <field name="state"/>
                <field name="responsible_user_id"/>
                <field name="started_at"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bold fs-5"><field name="name"/></div>
                            <div class="mt-2"><strong>Projekt:</strong> <field name="project_id"/></div>
                            <div><strong>Auftrag:</strong> <field name="production_order_id"/></div>
                            <div t-if="record.delivery_date.raw_value"><strong>Liefertermin:</strong> <field name="delivery_date"/></div>
                            <div class="mt-2"><field name="state" widget="badge"/></div>
                            <div class="mt-3 d-flex gap-2 flex-wrap">
                                <button name="action_claim" type="object" string="Übernehmen" class="btn btn-secondary" invisible="responsible_user_id or state not in ('pending', 'in_progress')"/>
                                <button name="action_start" type="object" string="Start" class="btn btn-primary" invisible="state != 'pending'"/>
                                <button name="action_done" type="object" string="Fertig" class="btn btn-success" invisible="state not in ('pending', 'in_progress')"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sab_employee_step_form" model="ir.ui.view">
        <field name="name">sab.production.step.employee.form</field>
        <field name="model">sab.production.step</field>
        <field name="arch" type="xml">
            <form string="Meine Arbeit">
                <header>
                    <button name="action_claim" type="object" string="Arbeit übernehmen" class="btn-secondary" invisible="responsible_user_id or state not in ('pending', 'in_progress')"/>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_done" type="object" string="Fertig melden" class="btn-primary" invisible="state not in ('pending', 'in_progress')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="production_order_id" readonly="1"/>
                        <field name="delivery_date" readonly="1"/>
                        <field name="responsible_user_id" readonly="1"/>
                        <field name="started_at" readonly="1"/>
                        <field name="finished_at" readonly="1"/>
                    </group>
                    <group string="Rückmeldung">
                        <field name="note" placeholder="Bemerkung zum Arbeitsschritt ..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sab_employee_my_steps" model="ir.actions.act_window">
        <field name="name">Meine Arbeit</field>
        <field name="res_model">sab.production.step</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('responsible_user_id', '=', uid), ('state', 'in', ('pending', 'in_progress'))]</field>
        <field name="context">{'search_default_my_work': 1}</field>
    </record>

    <record id="action_sab_employee_open_steps" model="ir.actions.act_window">
        <field name="name">Freie Arbeit</field>
        <field name="res_model">sab.production.step</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('responsible_user_id', '=', False), ('state', '=', 'pending'), ('production_state', 'in', ('planned', 'in_progress'))]</field>
    </record>

    <menuitem id="sab_employee_mobile_root_menu" name="Mitarbeiter" parent="sab_calculation_root_menu" sequence="160"/>
    <menuitem id="sab_employee_my_steps_menu" name="Meine Arbeit" parent="sab_employee_mobile_root_menu" action="action_sab_employee_my_steps" sequence="10"/>
    <menuitem id="sab_employee_open_steps_menu" name="Freie Arbeit" parent="sab_employee_mobile_root_menu" action="action_sab_employee_open_steps" sequence="20"/>
</odoo>
