<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_production_document_list" model="ir.ui.view">
        <field name="name">sab.production.document.list</field>
        <field name="model">sab.production.document</field>
        <field name="arch" type="xml">
            <list string="Protokolle &amp; Fertigungsdokumente" create="0">
                <field name="project_reference" string="Auftrag"/>
                <field name="project_name"/>
                <field name="customer_name"/>
                <field name="cabinet_name" string="Verteiler"/>
                <field name="cabinet_instance_label" string="Physischer Schrank"/>
                <field name="cabinet_product_id" string="Schrankprodukt" optional="show"/>
                <field name="document_type"/>
                <field name="state" widget="badge"/>
                <field name="delivery_date" optional="show"/>
                <field name="responsible_name" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sab_production_document_search" model="ir.ui.view">
        <field name="name">sab.production.document.search</field>
        <field name="model">sab.production.document</field>
        <field name="arch" type="xml">
            <search string="Protokolle &amp; Fertigungsdokumente">
                <field name="project_reference"/>
                <field name="project_name"/>
                <field name="customer_name"/>
                <field name="cabinet_name"/>
                <field name="cabinet_instance_label"/>
                <field name="cabinet_product_id"/>
                <field name="document_type"/>
                <field name="state"/>
                <group>
                    <filter name="group_project" string="Projekt" context="{'group_by':'project_id'}"/>
                    <filter name="group_cabinet" string="Verteiler" context="{'group_by':'cabinet_bom_id'}"/>
                    <filter name="group_type" string="Dokumentart" context="{'group_by':'document_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sab_production_document_form" model="ir.ui.view">
        <field name="name">sab.production.document.form</field>
        <field name="model">sab.production.document</field>
        <field name="arch" type="xml">
            <form string="SAB-P Protokoll / Fertigungsdokument">
                <header>
                    <button name="action_mark_completed" type="object" string="Als ausgefüllt markieren" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_printed" type="object" string="Als gedruckt markieren" class="btn-primary" invisible="state == 'printed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,completed,printed"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group string="Projekt- und Verteilerdaten" col="4">
                        <field name="production_order_id" readonly="1"/>
                        <field name="cabinet_bom_id" readonly="1"/>
                        <field name="cabinet_instance_label" readonly="1"/>
                        <field name="cabinet_instance_no" readonly="1"/>
                        <field name="cabinet_instance_count" readonly="1"/>
                        <field name="cabinet_product_id" readonly="1"/>
                        <field name="project_reference" readonly="1"/>
                        <field name="project_name" readonly="1"/>
                        <field name="customer_name" readonly="1"/>
                        <field name="customer_street" readonly="1"/>
                        <field name="customer_zip" readonly="1"/>
                        <field name="customer_city" readonly="1"/>
                        <field name="cabinet_name" readonly="1"/>
                        <field name="responsible_name" readonly="1"/>
                        <field name="delivery_date" readonly="1"/>
                        <field name="document_type" readonly="1"/>
                    </group>
                    <group string="Typenschild / technische Daten" col="4" invisible="document_type not in ('nameplate','production_test','final_inspection','conformity')">
                        <field name="cabinet_width_mm"/>
                        <field name="type_designation"/>
                        <field name="cabinet_type"/>
                        <field name="construction_year"/>
                        <field name="standard_family"/>
                        <field name="standard_part"/>
                        <field name="rated_voltage"/>
                        <field name="rated_current"/>
                        <field name="frequency"/>
                        <field name="busbar_current"/>
                        <field name="protection_class"/>
                        <field name="ip_rating"/>
                    </group>
                    <group string="Prüfdaten" col="4" invisible="document_type not in ('production_test','final_inspection','info_sheet')">
                        <field name="test_voltage"/>
                        <field name="insulation_resistance"/>
                        <field name="protective_conductor_resistance"/>
                        <field name="inspector_name"/>
                        <field name="inspection_date"/>
                        <field name="next_maintenance_date"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sab_production_documents" model="ir.actions.act_window">
        <field name="name">Protokolle</field>
        <field name="res_model">sab.production.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sab_production_document_list"/>
        <field name="search_view_id" ref="view_sab_production_document_search"/>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="sab_production_document_menu"
              name="Protokolle"
              parent="sab_technical_root_menu"
              action="action_sab_production_documents"
              sequence="20"
              groups="project.group_project_manager"/>

    <record id="view_sab_production_order_form_documents" model="ir.ui.view">
        <field name="name">sab.production.order.form.documents</field>
        <field name="model">sab.production.order</field>
        <field name="inherit_id" ref="sab_project.view_sab_production_order_form"/>
        <field name="priority">300</field>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_prepare_production_documents"
                        type="object"
                        string="Protokolle vorbereiten"
                        class="btn-secondary"
                        invisible="state == 'cancel'"/>
                <button name="action_view_production_documents"
                        type="object"
                        string="Protokolle öffnen"
                        invisible="document_count == 0"/>
            </xpath>
            <xpath expr="//sheet/group[1]" position="inside">
                <field name="document_count" readonly="1"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Protokolle" name="sab_production_documents" invisible="document_count == 0">
                        <field name="document_ids" nolabel="1" readonly="1">
                            <list create="0" delete="0">
                                <field name="cabinet_name" string="Verteiler"/>
                                <field name="cabinet_instance_label" string="Physischer Schrank"/>
                                <field name="cabinet_product_id" string="Schrankprodukt" optional="show"/>
                                <field name="document_type"/>
                                <field name="state" widget="badge"/>
                                <field name="inspection_date" optional="show"/>
                                <field name="inspector_name" optional="show"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
