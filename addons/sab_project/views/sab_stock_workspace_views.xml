<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sab_internal_transfers" model="ir.actions.act_window">
        <field name="name">Umlagerungen</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_id.code','=','internal')]</field>
        <field name="context">{'default_company_id': allowed_company_ids[0] if allowed_company_ids else False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Interne Umlagerung anlegen</p>
            <p>Material wird mit einem echten Odoo-Lagervorgang von einem Lagerplatz auf einen anderen gebucht.</p>
        </field>
    </record>

    <menuitem id="sab_real_stock_menu"
              name="Bestand"
              parent="sab_stock_root_menu"
              action="stock.action_view_quants"
              sequence="55"
              groups="sab_project.group_sab_warehouse,sab_project.group_sab_purchasing"/>

    <menuitem id="sab_stock_locations_menu"
              name="Lagerplätze"
              parent="sab_stock_root_menu"
              action="stock.action_location_form"
              sequence="56"
              groups="sab_project.group_sab_warehouse,sab_project.group_sab_purchasing"/>

    <menuitem id="sab_stock_inventory_menu"
              name="Inventur"
              parent="sab_stock_root_menu"
              action="stock.action_view_inventory_tree"
              sequence="57"
              groups="sab_project.group_sab_warehouse"/>

    <menuitem id="sab_internal_transfers_menu"
              name="Umlagerungen"
              parent="sab_stock_root_menu"
              action="action_sab_internal_transfers"
              sequence="58"
              groups="sab_project.group_sab_warehouse,sab_project.group_sab_purchasing"/>
</odoo>
