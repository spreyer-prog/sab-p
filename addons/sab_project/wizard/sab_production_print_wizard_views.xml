<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_production_print_wizard_form" model="ir.ui.view">
        <field name="name">sab.production.print.wizard.form</field>
        <field name="model">sab.production.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Fertigungsdruck">
                <sheet>
                    <group col="4">
                        <field name="production_order_id" readonly="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="order_id" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Für jeden Verteiler bzw. physischen Schrank die gewünschten Blätter anhaken.
                        Nicht markierte Dokumente werden nicht gedruckt.
                        Die Konformitätserklärung befindet sich unter „Protokolle“ und gehört nicht zum Fertigungsdruck.
                    </div>
                    <group col="2">
                        <button name="action_select_all" type="object" string="Alle Blätter markieren" class="btn-secondary"/>
                        <button name="action_clear_all" type="object" string="Alle Häkchen entfernen" class="btn-secondary"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="cabinet_bom_id" string="Verteiler" readonly="1"/>
                            <field name="cabinet_instance_label" string="Physischer Schrank" readonly="1"/>
                            <field name="cabinet_instance_no" column_invisible="1"/>
                            <field name="print_run_card" string="Laufkarte"/>
                            <field name="print_missing_parts" string="Bestellvorlage"/>
                            <field name="print_final_inspection" string="Endprüfung"/>
                            <field name="print_shipping_sheet" string="Versand"/>
                            <field name="print_add_pack" string="Beipack"/>
                            <field name="print_nameplate" string="Typenschild"/>
                            <field name="print_info_sheet" string="Infoschild / Prüfetikett"/>
                            <field name="print_folder_label" string="Ordneretikett"/>
                            <field name="print_production_test" string="Prüfprotokoll Fertigung"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_print_selected" type="object" string="Auswahl als PDF drucken / speichern" class="btn-primary"/>
                    <button string="Abbrechen" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
