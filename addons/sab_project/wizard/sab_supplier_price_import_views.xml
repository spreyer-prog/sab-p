<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_supplier_price_import_form" model="ir.ui.view">
        <field name="name">sab.supplier.price.import.form</field>
        <field name="model">sab.supplier.price.import</field>
        <field name="arch" type="xml">
            <form string="Preis-/Rabattliste importieren">
                <sheet>
                    <group>
                        <field name="supplier_id"/>
                        <field name="file_name" invisible="1"/>
                        <field name="file_data" filename="file_name"/>
                    </group>
                    <group string="Unterstützte Formate">
                        <div class="o_form_label">CSV, XLSX oder ZIP mit CSV/XLSX. Erkannte Spalten: Artikelnummer, Listenpreis, Rabatt, Netto-EK und Platzeinheiten.</div>
                    </group>
                    <group string="Ergebnis" invisible="not result_text">
                        <field name="result_text" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Preis-/Rabattliste importieren" class="btn-primary"/>
                    <button string="Schließen" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sab_supplier_price_import" model="ir.actions.act_window">
        <field name="name">Preis-/Rabattliste importieren</field>
        <field name="res_model">sab.supplier.price.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_supplier_id': active_id}</field>
    </record>
</odoo>
