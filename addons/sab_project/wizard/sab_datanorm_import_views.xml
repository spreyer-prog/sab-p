<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_datanorm_import_form" model="ir.ui.view">
        <field name="name">sab.datanorm.import.form</field>
        <field name="model">sab.datanorm.import</field>
        <field name="arch" type="xml">
            <form string="DATANORM 5 importieren">
                <group string="Importdatei">
                    <field name="file_data" filename="file_name" readonly="import_state == 'running'"/>
                    <field name="file_name" invisible="1"/>
                    <field name="supplier_id" readonly="import_state == 'running'"/>
                    <field name="create_missing_products" readonly="import_state == 'running'"/>
                    <field name="source_file_name" readonly="1" invisible="not source_file_name"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Es kann eine DATANORM-5-Datei (.001) oder direkt das Lieferanten-ZIP hochgeladen werden.
                    Bei ABB wird die Variante mit Typbezeichnung im Kurztext automatisch bevorzugt.
                    Technische SAB-P-Zeiten und Platzeinheiten werden nicht überschrieben.
                </div>
                <group string="Importstatus" invisible="import_state == 'ready'">
                    <field name="import_state" readonly="1"/>
                    <field name="progress_percent" widget="progressbar" readonly="1"/>
                    <field name="processed_records" readonly="1"/>
                    <field name="total_records" readonly="1"/>
                    <field name="current_status" readonly="1"/>
                    <field name="error_records" readonly="1"/>
                    <field name="last_error" readonly="1" invisible="not last_error"/>
                </group>
                <group string="Importprotokoll" invisible="not result_text">
                    <field name="result_text" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="DATANORM importieren" class="btn-primary" invisible="import_state == 'running'"/>
                    <button string="Schließen" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sab_datanorm_import" model="ir.actions.act_window">
        <field name="name">DATANORM 5 importieren</field>
        <field name="res_model">sab.datanorm.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="sab_datanorm_import_menu" name="DATANORM importieren" parent="sab_settings_import_root_menu" action="action_sab_datanorm_import" sequence="20" groups="project.group_project_manager"/>
</odoo>
