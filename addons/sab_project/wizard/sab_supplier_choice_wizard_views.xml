<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sab_supplier_choice_wizard_form" model="ir.ui.view">
        <field name="name">sab.supplier.choice.wizard.form</field>
        <field name="model">sab.supplier.choice.wizard</field>
        <field name="arch" type="xml">
            <form string="Lieferant auswählen">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Für Produkte mit mehreren hinterlegten Lieferanten bitte den gewünschten Lieferanten auswählen. Preis und Lieferzeit werden aus dem gewählten Lieferantenartikel übernommen.
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="requirement_id" readonly="1"/>
                            <field name="odoo_product_id" readonly="1"/>
                            <field name="supplier_product_id"/>
                            <field name="supplier_id" readonly="1"/>
                            <field name="supplier_article_number" readonly="1"/>
                            <field name="net_purchase_price" readonly="1"/>
                            <field name="delivery_time_days" readonly="1"/>
                            <field name="preferred" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_continue" type="object" string="Bestellvorschlag erzeugen" class="btn-primary"/>
                    <button string="Abbrechen" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
