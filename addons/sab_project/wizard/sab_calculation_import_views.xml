<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sab_calculation_import_form" model="ir.ui.view">
        <field name="name">sab.calculation.import.form</field>
        <field name="model">sab.calculation.import</field>

        <field name="arch" type="xml">

            <form string="Kalkulationsdatenbank importieren">

                <sheet>

                    <group string="SAB-P Kalkulationsdatenbank">

                        <field
                            name="file_data"
                            filename="filename"
                            readonly="state != 'upload'"
                        />

                        <field
                            name="filename"
                            invisible="1"
                        />

                        <field
                            name="state"
                            readonly="1"
                        />

                    </group>

                    <group
                        string="Dateiinformation"
                        invisible="state == 'upload'"
                    >

                        <field
                            name="detected_sheet_count"
                            readonly="1"
                        />

                        <field
                            name="detected_row_count"
                            readonly="1"
                        />

                    </group>

                    <group
                        string="Importergebnis"
                        invisible="state != 'imported'"
                    >

                        <field
                            name="imported_count"
                            readonly="1"
                        />

                        <field
                            name="duplicate_count"
                            readonly="1"
                        />

                        <field
                            name="skipped_count"
                            readonly="1"
                        />

                    </group>

                    <group invisible="state == 'upload'">

                        <field
                            name="workbook_info"
                            readonly="1"
                            nolabel="1"
                        />

                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_check_file"
                        string="Datei prüfen"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'upload'"
                    />

                    <button
                        name="action_import"
                        string="Kalkulationsartikel importieren"
                        type="object"
                        class="btn-primary"
                        confirm="Die Kalkulationsartikel werden jetzt in die SAB-P Kalkulationsdatenbank übernommen. Fortfahren?"
                        invisible="state != 'checked'"
                    />

                    <button
                        name="action_reset"
                        string="Andere Datei auswählen"
                        type="object"
                        invisible="state == 'upload'"
                    />

                    <button
                        string="Schließen"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>

</odoo>