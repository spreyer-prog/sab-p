<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sab_calculation_import_form" model="ir.ui.view">
        <field name="name">sab.calculation.import.form</field>
        <field name="model">sab.calculation.import</field>
        <field name="arch" type="xml">
            <form string="Kalkulationsdatenbank importieren">

                <group>
                    <field name="file_data" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>

                <footer>
                    <button
                        string="Import starten"
                        name="action_import"
                        type="object"
                        class="btn-primary"/>

                    <button
                        string="Abbrechen"
                        special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>